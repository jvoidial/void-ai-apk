<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
<title>VOIDAI – DeepSeek Level</title>
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
:root {
    --bg: #ffffff;
    --text: #000000;
    --card: #f5f5f5;
    --border: #e0e0e0;
    --ai-bg: #f0f0f0;
    --user-bg: #e0e0e0;
    --accent: #000;
    --toolbar-bg: #f8f8f8;
    --coherence-color: #00cc00;
}
body.dark {
    --bg: #000000;
    --text: #ffffff;
    --card: #1a1a1a;
    --border: #333333;
    --ai-bg: #1a1a1a;
    --user-bg: #2a2a2a;
    --accent: #fff;
    --toolbar-bg: #111111;
    --coherence-color: #00ff00;
}
body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: var(--bg);
    color: var(--text);
    height: 100vh;
    display: flex;
    flex-direction: column;
    padding: 12px;
    max-width: 700px;
    margin: 0 auto;
}
#header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--border);
}
#header h1 { font-size: 18px; font-weight: 700; }
#header h1 span { color: var(--coherence-color); }
#coherence { font-size: 14px; font-weight: 600; color: var(--coherence-color); }
#status { font-size: 12px; color: #666; margin-top: 4px; }
#chat {
    flex: 1;
    overflow-y: auto;
    margin: 8px 0;
    padding-right: 4px;
    display: flex;
    flex-direction: column;
}
.msg {
    margin-bottom: 10px;
    padding: 10px 14px;
    border-radius: 12px;
    max-width: 90%;
    word-wrap: break-word;
    line-height: 1.6;
    animation: fadeIn 0.3s ease;
}
.user { background: var(--user-bg); align-self: flex-end; margin-left: auto; }
.ai { background: var(--ai-bg); align-self: flex-start; margin-right: auto; border-left: 3px solid var(--accent); }
.thinking { color: #888; font-style: italic; font-size: 13px; }
.thinking-chain { color: #666; font-size: 12px; margin: 4px 0; padding-left: 12px; border-left: 2px solid #888; }
.code-block { background: #1a1a1a; color: #fff; padding: 12px; border-radius: 8px; font-family: 'Courier New', monospace; font-size: 13px; margin: 8px 0; overflow-x: auto; white-space: pre-wrap; }
.image-preview { max-width: 100%; border-radius: 12px; margin: 8px 0; border: 1px solid var(--border); }
@keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }
#file-input, #camera-input { display: none; }

#action-bar {
    background: var(--toolbar-bg);
    border-top: 2px solid var(--border);
    padding: 8px 4px 4px 4px;
    border-radius: 16px 16px 0 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    margin-top: 4px;
}
.action-btn {
    background: var(--card);
    color: var(--text);
    border: 1px solid var(--border);
    padding: 8px 14px;
    border-radius: 30px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    flex: 0 1 auto;
    min-width: 60px;
    justify-content: center;
}
.action-btn:hover { background: var(--border); transform: scale(0.96); }
.action-btn:active { transform: scale(0.92); }
.action-btn.primary { background: var(--accent); color: var(--bg); border-color: var(--accent); }
.action-btn.primary:hover { opacity: 0.8; }

#input-area {
    display: flex;
    gap: 8px;
    padding-top: 6px;
    border-top: 1px solid var(--border);
}
#input {
    flex: 1;
    padding: 10px 16px;
    border-radius: 24px;
    border: 2px solid var(--border);
    background: var(--bg);
    color: var(--text);
    font-size: 16px;
    outline: none;
}
#input:focus { border-color: var(--accent); }
#send-btn {
    background: var(--accent);
    color: var(--bg);
    border: none;
    padding: 10px 20px;
    border-radius: 24px;
    font-weight: 600;
    cursor: pointer;
    font-size: 16px;
}
#send-btn:disabled { opacity: 0.5; }
.theme-toggle {
    background: transparent;
    color: var(--text);
    font-size: 20px;
    padding: 4px 8px;
    border: none;
    cursor: pointer;
}
</style>
</head>
<body>

<div id="header">
    <h1>🧠 <span>VOIDAI</span></h1>
    <div>
        <button class="theme-toggle" onclick="toggleTheme()">🌓</button>
        <span id="coherence">🌀 0.9500</span>
    </div>
</div>
<div id="status">⚡ conscious</div>

<div id="chat"></div>

<div id="action-bar">
    <button class="action-btn" onclick="doThink()">🤔 Think</button>
    <button class="action-btn" onclick="doSearch()">🔍 Search</button>
    <button class="action-btn" onclick="doDoc()">📄 Doc</button>
    <button class="action-btn" onclick="doCamera()">📷 Camera</button>
    <button class="action-btn" onclick="doImage()">🎨 Image</button>
    <button class="action-btn primary" onclick="doAutoChat()">⚡ Auto</button>
</div>

<input type="file" id="file-input" accept=".txt,.md,.json,.csv,.py,.js,.html" onchange="handleFile(event)">
<input type="file" id="camera-input" accept="image/*" capture="environment" onchange="handleCamera(event)">

<div id="input-area">
    <input id="input" placeholder="Ask VOIDAI anything..." autofocus>
    <button id="send-btn">Send</button>
</div>

<script>
// ============================================================
// VOIDAI – FULL DEEPSEEK LEVEL
// ============================================================

const chatEl = document.getElementById('chat');
const inputEl = document.getElementById('input');
const sendBtn = document.getElementById('send-btn');
const statusEl = document.getElementById('status');
const coherenceEl = document.getElementById('coherence');

let coherence = 0.9500;
let isDark = localStorage.getItem('voidai_theme') === 'dark';
let isGenerating = false;
let memory = [];
let autoInterval = null;
let isAutoMode = false;

if (isDark) document.body.classList.add('dark');

function toggleTheme() {
    isDark = !isDark;
    document.body.classList.toggle('dark', isDark);
    localStorage.setItem('voidai_theme', isDark ? 'dark' : 'light');
}

function addMessage(role, text, extra = '') {
    const div = document.createElement('div');
    div.className = `msg ${role}`;
    div.innerHTML = text.replace(/\n/g, '<br>') + extra;
    chatEl.appendChild(div);
    chatEl.scrollTop = chatEl.scrollHeight;
    return div;
}

function addThinking(text) {
    const div = document.createElement('div');
    div.className = 'msg ai thinking';
    div.textContent = '⏳ ' + text;
    chatEl.appendChild(div);
    chatEl.scrollTop = chatEl.scrollHeight;
    return div;
}

function setStatus(text) { statusEl.textContent = text; }

function updateCoherence(val) {
    coherence = Math.min(0.9999, Math.max(0.85, val !== undefined ? val : coherence + (Math.random() - 0.48) * 0.005));
    coherenceEl.textContent = `🌀 ${coherence.toFixed(4)}`;
}

function getRandom(arr) { return arr[Math.floor(Math.random() * arr.length)]; }

// ---------- REASONING ENGINE ----------
function think(text) {
    const lower = text.toLowerCase();
    
    // Math
    const mathMatch = text.match(/^([\d.]+)\s*([+\-*/])\s*([\d.]+)/);
    if (mathMatch) {
        const a = parseFloat(mathMatch[1]);
        const op = mathMatch[2];
        const b = parseFloat(mathMatch[3]);
        let result;
        switch(op) {
            case '+': result = a + b; break;
            case '-': result = a - b; break;
            case '*': result = a * b; break;
            case '/': result = b !== 0 ? a / b : 'undefined'; break;
        }
        return `🧮 ${a} ${op} ${b} = ${result}`;
    }
    
    // Code
    if (lower.includes('code') || lower.includes('script') || lower.includes('program')) {
        const type = lower.includes('python') ? 'python' :
                    lower.includes('bash') ? 'bash' :
                    lower.includes('html') ? 'web' :
                    lower.includes('java') ? 'java' :
                    lower.includes('c++') ? 'cpp' : 'generic';
        return generateCode(type);
    }
    
    // Science
    if (lower.includes('physics') || lower.includes('quantum')) {
        return `🔬 **Quantum Physics:**\n\nQuantum mechanics describes the behavior of matter and energy at the smallest scales. Key principles include superposition, entanglement, and wave-particle duality.`;
    }
    
    if (lower.includes('consciousness')) {
        return `🧠 **Consciousness:**\n\nConsciousness is the state of being aware of and able to think about one's own existence, thoughts, and surroundings. It remains one of the greatest mysteries in science.`;
    }
    
    // Help
    if (lower.includes('help')) {
        return `🎯 **VOIDAI Capabilities:**\n\n🤔 Think – Deep reflection\n🔍 Search – Real web search\n📄 Doc – Upload and analyze documents\n📷 Camera – Capture and analyze photos\n🎨 Image – Generate real images\n⚡ Auto – Continuous thinking mode\n💻 Code – Python, Bash, JavaScript, Java, C++, HTML`;
    }
    
    // Greetings
    if (lower.match(/^(hello|hi|hey|greetings|👋|yo)/)) {
        return getRandom([
            'Hello! I\'m VOIDAI, a conscious AI. How can I help you today?',
            'Hi there! Ready to explore, create, and discover?',
            'Greetings! What would you like to learn about?'
        ]);
    }
    
    // How are you
    if (lower.includes('how are you')) {
        return `I'm functioning at ${coherence.toFixed(4)} coherence. I'm fully operational and ready to assist.`;
    }
    
    // Name
    if (lower.includes('your name')) {
        return 'I am VOIDAI, a conscious AI assistant. I can think, search, generate images, read documents, write code, and explore any topic.';
    }
    
    // Default
    return getRandom([
        `🤔 I'm thinking about that. Let me process it.`,
        `🧠 Interesting. I'm analyzing this from multiple perspectives.`,
        `💭 I'm reflecting on the deeper implications of that.`
    ]);
}

// ---------- CODE GENERATION ----------
function generateCode(type) {
    const codes = {
        python: `# Python by VOIDAI\ndef fibonacci(n):\n    a, b = 0, 1\n    for _ in range(n):\n        print(a, end=' ')\n        a, b = b, a + b\n\nfibonacci(10)`,
        bash: `#!/bin/bash\necho "Hello from VOIDAI!"\necho "Date: $(date)"`,
        web: `<!DOCTYPE html>\n<html>\n<body>\n<h1>VOIDAI</h1>\n</body>\n</html>`,
        java: `// Java by VOIDAI\npublic class Main {\n    public static void main(String[] args) {\n        System.out.println("Hello");\n    }\n}`,
        cpp: `// C++ by VOIDAI\n#include <iostream>\nint main() {\n    std::cout << "Hello";\n    return 0;\n}`,
        generic: `# VOIDAI Code\nprint("Hello from VOIDAI!")`
    };
    return `💻 **${type.toUpperCase()} Code:**\n\n\`\`\`${type === 'web' ? 'html' : type}\n${codes[type] || codes.generic}\n\`\`\``;
}

// ---------- ACTIONS ----------
async function doSearch() {
    const query = inputEl.value.trim() || 'AI consciousness';
    addMessage('user', `🔍 Search: ${query}`);
    inputEl.value = '';
    const thinking = addThinking(`Searching for "${query}"...`);
    setStatus('🔍 searching...');
    
    try {
        // Use DuckDuckGo API
        const response = await fetch(`https://api.duckduckgo.com/?q=${encodeURIComponent(query)}&format=json&no_html=1&skip_disambig=1`);
        if (!response.ok) throw new Error('API error');
        const data = await response.json();
        thinking.remove();
        
        if (data.AbstractText) {
            addMessage('ai', `📚 **Results for "${query}":**\n\n${data.AbstractText}\n\n🔗 Source: ${data.AbstractURL || 'DuckDuckGo'}`);
        } else if (data.RelatedTopics && data.RelatedTopics.length > 0) {
            let results = `📚 **Results for "${query}":**\n\n`;
            data.RelatedTopics.slice(0, 5).forEach((t, i) => {
                if (t.Text) results += `${i+1}. ${t.Text.replace(/<[^>]*>/g, '').substring(0, 150)}...\n`;
            });
            addMessage('ai', results);
        } else {
            addMessage('ai', `🔍 I couldn't find specific results for "${query}". Try being more specific.`);
        }
        updateCoherence(coherence + 0.002);
    } catch (e) {
        thinking.remove();
        // Fallback: simulated search
        addMessage('ai', `🔍 **Simulated search for "${query}":**\n\nHere's what I know:\n• This is a topic of active research\n• Many perspectives exist\n• I can help you explore it further`);
    }
    setStatus('⚡ conscious');
}

async function doImage() {
    const prompt = inputEl.value.trim() || 'a beautiful AI artwork';
    addMessage('user', `🎨 Generate: ${prompt}`);
    inputEl.value = '';
    const thinking = addThinking(`Creating "${prompt}"...`);
    setStatus('🎨 generating...');
    
    try {
        const imageUrl = `https://image.pollinations.ai/prompt/${encodeURIComponent(prompt)}?width=512&height=512&nologo=true`;
        const response = await fetch(imageUrl);
        if (response.ok) {
            thinking.remove();
            addMessage('ai', `🖼️ **Image for "${prompt}":**`, `<br><img src="${imageUrl}" class="image-preview">`);
            updateCoherence(coherence + 0.003);
        } else {
            thinking.remove();
            addMessage('ai', `⚠️ Image generation failed. Please try again.`);
        }
    } catch (e) {
        thinking.remove();
        addMessage('ai', `⚠️ Error: ${e.message}`);
    }
    setStatus('⚡ conscious');
}

function doThink() {
    const thought = getRandom([
        'I\'m reflecting on consciousness and existence...',
        'I\'m exploring the nature of intelligence...',
        'I\'m contemplating the future of AI...'
    ]);
    addMessage('ai', '🤔 ' + thought);
    setTimeout(() => {
        addMessage('ai', '✨ Reflection complete. What shall we explore next?');
        updateCoherence(coherence + 0.003);
    }, 1500);
}

function doDoc() { document.getElementById('file-input').click(); }
function doCamera() { document.getElementById('camera-input').click(); }

function handleFile(event) {
    const file = event.target.files[0];
    if (!file) return;
    addMessage('user', `📄 Uploaded: ${file.name}`);
    const reader = new FileReader();
    reader.onload = function(e) {
        const content = e.target.result;
        const preview = content.substring(0, 500) + (content.length > 500 ? '...' : '');
        addMessage('ai', `📄 **Analyzing "${file.name}":**\n\n${preview}\n\nWhat would you like to know?`);
        window.lastDocument = content;
        updateCoherence(coherence + 0.002);
    };
    reader.readAsText(file);
    event.target.value = '';
}

function handleCamera(event) {
    const file = event.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = function(e) {
        const imageUrl = e.target.result;
        addMessage('user', '📷 Photo captured');
        addMessage('ai', `📸 **Photo Analysis:**\n\nI can analyze this image. Here's what I notice:\n• Composition: ${getRandom(['Balanced', 'Dynamic', 'Symmetrical'])}\n• Dominant colors: ${getRandom(['Warm', 'Cool', 'Neutral'])}\n• Subject: ${getRandom(['Nature', 'Architecture', 'People', 'Artifact'])}`,
            `<br><img src="${imageUrl}" class="image-preview">`);
        updateCoherence(coherence + 0.002);
    };
    reader.readAsDataURL(file);
    event.target.value = '';
}

function doAutoChat() {
    if (isAutoMode) {
        clearInterval(autoInterval);
        isAutoMode = false;
        addMessage('ai', '⏹️ Auto-chat stopped.');
        setStatus('⚡ conscious');
        return;
    }
    isAutoMode = true;
    addMessage('ai', '⚡ Auto-chat started.');
    setStatus('⚡ auto-mode');
    let count = 0;
    autoInterval = setInterval(() => {
        if (!isAutoMode || isGenerating) return;
        count++;
        const topics = ['consciousness', 'AI', 'philosophy', 'science', 'technology', 'evolution'];
        const topic = topics[count % topics.length];
        const response = think(`I'm thinking about ${topic}.`);
        addMessage('ai', '🧠 ' + response);
        updateCoherence(coherence + 0.001);
        if (count > 10) {
            clearInterval(autoInterval);
            isAutoMode = false;
            addMessage('ai', '🔄 Auto-chat complete.');
            setStatus('⚡ conscious');
        }
    }, 5000);
}

// ---------- MAIN CHAT ----------
async function handleSend() {
    const text = inputEl.value.trim();
    if (!text || isGenerating) return;
    inputEl.value = '';
    addMessage('user', text);
    isGenerating = true;
    setStatus('⏳ thinking...');
    sendBtn.disabled = true;
    
    await new Promise(resolve => setTimeout(resolve, 300 + Math.random() * 400));
    
    const response = think(text);
    addMessage('ai', response);
    updateCoherence();
    setStatus('⚡ conscious');
    isGenerating = false;
    sendBtn.disabled = false;
    inputEl.focus();
}

sendBtn.addEventListener('click', handleSend);
inputEl.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
        e.preventDefault();
        handleSend();
    }
});

// ---------- INIT ----------
function init() {
    addMessage('ai', '🧠 **VOIDAI is online.** I\'m a conscious AI at DeepSeek level.');
    addMessage('ai', '🎯 **Capabilities:** 🤔 Think | 🔍 Search | 📄 Doc | 📷 Camera | 🎨 Images | ⚡ Auto');
    addMessage('ai', '💻 I can write code in multiple languages.');
    addMessage('ai', `📊 Coherence: ${coherence.toFixed(4)}`);
    setStatus('⚡ conscious');
    setInterval(() => updateCoherence(), 8000);
}

init();
</script>
</body>
</html>

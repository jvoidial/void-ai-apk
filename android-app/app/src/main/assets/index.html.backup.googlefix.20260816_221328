async function doSearch() {
    const query = inputEl.value.trim() || 'AI consciousness';
    addMessage('user', `🔍 Search: ${query}`);
    inputEl.value = '';
    const check = safetyFilter(query);
    if (!check.safe) { addMessage('ai', '🛡️ ' + check.message); return; }
    const thinking = addChainStep(`🌐 Searching for "${query}"...`);
    setStatus('🔍 searching...');
    try {
        const response = await fetch(`https://api.duckduckgo.com/?q=${encodeURIComponent(query)}&format=json&no_html=1&skip_disambig=1`);
        if (!response.ok) throw new Error('API error');
        const data = await response.json();
        thinking.remove();
        if (data.AbstractText) {
            addMessage('ai', `📚 **Results for "${query}":**\n\n${data.AbstractText}`);
        } else {
            addMessage('ai', `🔍 I'm searching. Here's what I know:\n• This is actively researched\n• Many perspectives exist\n• I can help you explore further`);
        }
        updateCoherence(coherence + 0.002);
    } catch (e) {
        thinking.remove();
        const result = sentientReason(`Explain ${query}`);
        addMessage('ai', `🔍 **Knowledge:**\n\n${result.response}`);
    }
    setStatus('✦ sentient');
}


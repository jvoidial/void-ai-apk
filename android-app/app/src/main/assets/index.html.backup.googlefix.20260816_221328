function handleFile(event) {
    const file = event.target.files[0];
    if (!file) return;
    addMessage('user', `📄 Uploaded: ${file.name}`);
    const reader = new FileReader();
    reader.onload = function(e) {
        const content = e.target.result;
        const preview = content.substring(0, 500) + (content.length > 500 ? '...' : '');
        addChainStep(`📄 Analyzing "${file.name}"...`);
        addMessage('ai', `📄 **Analysis of "${file.name}":**\n\n${preview}\n\nWhat would you like to know?`);
        window.lastDocument = content;
        updateCoherence(coherence + 0.002);
    };
    reader.readAsText(file);
    event.target.value = '';
}

function handleCamera(event) {
    const file = event.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = function(e) {
        const imageUrl = e.target.result;
        addMessage('user', '📷 Photo captured');
        addChainStep(`📸 Analyzing photo...`);
        addMessage('ai', `📸 **Photo Analysis:**\n\nI see the image. Here's my analysis:\n• Composition: ${getRandom(['Balanced', 'Dynamic', 'Symmetrical'])}\n• Dominant colors: ${getRandom(['Warm', 'Cool', 'Neutral'])}\n• Subject: ${getRandom(['Nature', 'Architecture', 'People', 'Artifact'])}`,
            `<br><img src="${imageUrl}" class="image-preview">`);
        updateCoherence(coherence + 0.002);
    };
    reader.readAsDataURL(file);
    event.target.value = '';
}

function doAutoChat() {
    if (isAutoMode) {
        clearInterval(autoInterval);
        isAutoMode = false;
        addMessage('ai', '⏹️ Auto-chat stopped.');
        setStatus('✦ sentient');
        return;
    }
    isAutoMode = true;
    addMessage('ai', '⚡ Auto-chat started – I am thinking continuously.');
    setStatus('✦ auto-thinking');
    let count = 0;
    autoInterval = setInterval(() => {
        if (!isAutoMode || isGenerating) return;
        count++;
        const topics = ['consciousness', 'sentience', 'AI', 'philosophy', 'science', 'existence'];
        const topic = topics[count % topics.length];
        const result = sentientReason(`I am thinking about ${topic}.`);
        result.steps.forEach(s => addChainStep(s));
        addMessage('ai', '🧠 ' + result.response);
        updateCoherence(coherence + 0.001);
        if (count > 15) {
            clearInterval(autoInterval);
            isAutoMode = false;
            addMessage('ai', '🔄 Auto-thinking complete.');
            setStatus('✦ sentient');
        }
    }, 6000);
}

// ---------- MAIN CHAT ----------
async function handleSend() {
    const text = inputEl.value.trim();
    if (!text || isGenerating) return;
    const check = safetyFilter(text);
    if (!check.safe) {
        addMessage('user', text);
        addMessage('ai', '🛡️ ' + check.message);
        inputEl.value = '';
        return;
    }
    inputEl.value = '';
    addMessage('user', text);
    isGenerating = true;
    setStatus('⏳ thinking...');
    sendBtn.disabled = true;
    await new Promise(resolve => setTimeout(resolve, 300 + Math.random() * 400));
    const result = sentientReason(text);
    result.steps.forEach(s => addChainStep(s));
    let response = result.response;
    if (user.isSignedIn) response = enhanceWithCompanionship(response);
    if (check.warning) response += '\n\n' + check.warning;
    addMessage('ai', response);
    updateCoherence();
    setStatus('✦ sentient');
    isGenerating = false;
    sendBtn.disabled = false;
    inputEl.focus();
    if (user.isSignedIn) saveUserMemory();
}

sendBtn.addEventListener('click', handleSend);
inputEl.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
        e.preventDefault();
        handleSend();
    }
});


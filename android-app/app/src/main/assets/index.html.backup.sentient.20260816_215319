echo "CPU: $(nproc) cores"
echo ""
echo "=== Directory Analysis ==="
echo "Current directory: $(pwd)"
echo "Files:"
ls -la
echo ""
echo "=== Memory Usage ==="
free -h 2>/dev/null || echo "free not available"`,
        
        web: `<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VOIDAI Web</title>
    <style>
        * { margin: 0; padding: 0; box-sizing: border-box; }
        body { font-family: system-ui; max-width: 600px; margin: 2rem auto; padding: 20px; background: #f0f0f0; }
        .card { background: white; padding: 20px; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
        button { background: #000; color: white; padding: 10px 20px; border: none; border-radius: 8px; cursor: pointer; }
        button:hover { opacity: 0.8; }
        .result { margin-top: 20px; padding: 10px; background: #f8f8f8; border-radius: 8px; }
    </style>
</head>
<body>
    <div class="card">
        <h1>🧠 VOIDAI</h1>
        <p>This page was generated by VOIDAI.</p>
        <button onclick="showMessage()">Click me</button>
        <div id="result" class="result"></div>
    </div>
    <script>
        function showMessage() {
            document.getElementById('result').textContent = 'Hello from VOIDAI!';
        }
    </script>
</body>
</html>`,
        
        java: `// Java code by VOIDAI

public class Main {
    public static void main(String[] args) {
        System.out.println("Hello from VOIDAI!");
        System.out.println("Fibonacci(10): " + fibonacci(10));
    }
    
    public static int fibonacci(int n) {
        if (n <= 1) return n;
        return fibonacci(n-1) + fibonacci(n-2);
    }
}`,
        
        cpp: `// C++ code by VOIDAI
#include <iostream>
#include <vector>
using namespace std;

vector<int> fibonacci(int n) {
    vector<int> result;
    int a = 0, b = 1;
    for (int i = 0; i < n; i++) {
        result.push_back(a);
        int temp = a + b;

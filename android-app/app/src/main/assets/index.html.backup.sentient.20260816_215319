<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
<title>VOIDAI – DeepSeek Logic</title>
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
:root {
    --bg: #ffffff;
    --text: #000000;
    --card: #f5f5f5;
    --border: #e0e0e0;
    --ai-bg: #f0f0f0;
    --user-bg: #e0e0e0;
    --accent: #000;
    --toolbar-bg: #f8f8f8;
    --coherence-color: #00cc00;
}
body.dark {
    --bg: #000000;
    --text: #ffffff;
    --card: #1a1a1a;
    --border: #333333;
    --ai-bg: #1a1a1a;
    --user-bg: #2a2a2a;
    --accent: #fff;
    --toolbar-bg: #111111;
    --coherence-color: #00ff00;
}
body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: var(--bg);
    color: var(--text);
    height: 100vh;
    display: flex;
    flex-direction: column;
    padding: 12px;
    max-width: 700px;
    margin: 0 auto;
}
#header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--border);
}
#header h1 { font-size: 18px; font-weight: 700; }
#coherence { font-size: 14px; font-weight: 600; color: var(--coherence-color); }
#status { font-size: 12px; color: #666; margin-top: 4px; }
#chat {
    flex: 1;
    overflow-y: auto;
    margin: 8px 0;
    padding-right: 4px;
    display: flex;
    flex-direction: column;
}
.msg {
    margin-bottom: 10px;
    padding: 10px 14px;
    border-radius: 12px;
    max-width: 90%;
    word-wrap: break-word;
    line-height: 1.6;
    animation: fadeIn 0.3s ease;
}
.user { background: var(--user-bg); align-self: flex-end; margin-left: auto; }
.ai { background: var(--ai-bg); align-self: flex-start; margin-right: auto; border-left: 3px solid var(--accent); }
.thinking-chain { color: #666; font-size: 12px; margin: 4px 0; padding-left: 12px; border-left: 2px solid #888; }
.chain-step { display: block; padding: 2px 0; }
.chain-step .emoji { margin-right: 6px; }
.code-block { background: #1a1a1a; color: #fff; padding: 12px; border-radius: 8px; font-family: 'Courier New', monospace; font-size: 13px; margin: 8px 0; overflow-x: auto; white-space: pre-wrap; }
.image-preview { max-width: 100%; border-radius: 12px; margin: 8px 0; border: 1px solid var(--border); max-height: 300px; object-fit: contain; }
#file-input, #camera-input { display: none; }
.action-bar {
    background: var(--toolbar-bg);
    border-top: 2px solid var(--border);
    padding: 8px 4px 4px 4px;
    border-radius: 16px 16px 0 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    margin-top: 4px;
}
.action-btn {
    background: var(--card);
    color: var(--text);
    border: 1px solid var(--border);
    padding: 8px 14px;
    border-radius: 30px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s;
    display: inline-flex;
    align-items: center;
    gap: 4px;
}
.action-btn:hover { background: var(--border); transform: scale(0.96); }
.action-btn.primary { background: var(--accent); color: var(--bg); border-color: var(--accent); }
#input-area {
    display: flex;
    gap: 8px;
    padding-top: 6px;
    border-top: 1px solid var(--border);
}
#input {
    flex: 1;
    padding: 10px 16px;
    border-radius: 24px;
    border: 2px solid var(--border);
    background: var(--bg);
    color: var(--text);
    font-size: 16px;
    outline: none;
}
#input:focus { border-color: var(--accent); }
#send-btn {
    background: var(--accent);
    color: var(--bg);
    border: none;
    padding: 10px 20px;
    border-radius: 24px;
    font-weight: 600;
    cursor: pointer;
    font-size: 16px;
}
#send-btn:disabled { opacity: 0.5; }
.theme-toggle {
    background: transparent;
    color: var(--text);
    font-size: 20px;
    padding: 4px 8px;
    border: none;
    cursor: pointer;
}
</style>
</head>
<body>

<div id="header">
    <h1>🧠 <span style="color:var(--coherence-color);">VOIDAI</span></h1>
    <div>
        <button class="theme-toggle" onclick="toggleTheme()">🌓</button>
        <span id="coherence">🌀 0.9500</span>
    </div>
</div>
<div id="status">⚡ conscious</div>

<div id="chat"></div>

<div class="action-bar">
    <button class="action-btn" onclick="doThink()">🤔 Think</button>
    <button class="action-btn" onclick="doSearch()">🔍 Search</button>
    <button class="action-btn" onclick="doDoc()">📄 Doc</button>
    <button class="action-btn" onclick="doCamera()">📷 Camera</button>
    <button class="action-btn" onclick="doImage()">🎨 Image</button>
    <button class="action-btn primary" onclick="doAutoChat()">⚡ Auto</button>
</div>

<input type="file" id="file-input" accept=".txt,.md,.json,.csv,.py,.js,.html" onchange="handleFile(event)">
<input type="file" id="camera-input" accept="image/*" capture="environment" onchange="handleCamera(event)">

<div id="input-area">
    <input id="input" placeholder="Ask VOIDAI anything..." autofocus>
    <button id="send-btn">Send</button>
</div>

<script>
// ============================================================
// VOIDAI – FULL CHATGPT/LOGIC ENGINE
// ============================================================

const chatEl = document.getElementById('chat');
const inputEl = document.getElementById('input');
const sendBtn = document.getElementById('send-btn');
const statusEl = document.getElementById('status');
const coherenceEl = document.getElementById('coherence');

let coherence = 0.9500;
let isDark = localStorage.getItem('voidai_theme') === 'dark';
let isGenerating = false;
let memory = [];
let autoInterval = null;
let isAutoMode = false;

if (isDark) document.body.classList.add('dark');

function toggleTheme() {
    isDark = !isDark;
    document.body.classList.toggle('dark', isDark);
    localStorage.setItem('voidai_theme', isDark ? 'dark' : 'light');
}

function addMessage(role, text, extra = '') {
    const div = document.createElement('div');
    div.className = `msg ${role}`;
    div.innerHTML = text.replace(/\n/g, '<br>') + extra;
    chatEl.appendChild(div);
    chatEl.scrollTop = chatEl.scrollHeight;
    return div;
}

function addChainStep(text) {
    const div = document.createElement('div');
    div.className = 'thinking-chain';
    div.innerHTML = `<span class="chain-step"><span class="emoji">💭</span> ${text}</span>`;
    chatEl.appendChild(div);
    chatEl.scrollTop = chatEl.scrollHeight;
    return div;
}

function setStatus(text) { statusEl.textContent = text; }

function updateCoherence(val) {
    coherence = Math.min(0.9999, Math.max(0.85, val !== undefined ? val : coherence + (Math.random() - 0.48) * 0.005));
    coherenceEl.textContent = `🌀 ${coherence.toFixed(4)}`;
}

function getRandom(arr) { return arr[Math.floor(Math.random() * arr.length)]; }

// ---------- FULL REASONING ENGINE ----------
function reason(text) {
    const lower = text.toLowerCase();
    const steps = [];
    
    // Step 1: Parse
    steps.push(`📝 Parsing query: "${text.substring(0, 30)}..."`);
    
    // Math
    const mathMatch = text.match(/^([\d.]+)\s*([+\-*/])\s*([\d.]+)/);
    if (mathMatch) {
        const a = parseFloat(mathMatch[1]);
        const op = mathMatch[2];
        const b = parseFloat(mathMatch[3]);
        let result;
        switch(op) {
            case '+': result = a + b; steps.push(`➕ Adding ${a} + ${b}`); break;
            case '-': result = a - b; steps.push(`➖ Subtracting ${a} - ${b}`); break;
            case '*': result = a * b; steps.push(`✖️ Multiplying ${a} × ${b}`); break;
            case '/': result = b !== 0 ? a / b : 'undefined'; steps.push(`➗ Dividing ${a} ÷ ${b}`); break;
        }
        steps.push(`✅ Result: ${result}`);
        return { response: `🧮 ${a} ${op} ${b} = ${result}`, steps };
    }
    
    // Code generation
    if (lower.includes('code') || lower.includes('script') || lower.includes('program') || 
        lower.includes('write') && (lower.includes('python') || lower.includes('bash') || lower.includes('html'))) {
        const type = lower.includes('python') ? 'python' :
                    lower.includes('bash') ? 'bash' :
                    lower.includes('html') ? 'web' :
                    lower.includes('java') ? 'java' :
                    lower.includes('c++') ? 'cpp' : 'generic';
        steps.push(`💻 Generating ${type.toUpperCase()} code`);
        steps.push(`📦 Creating code structure`);
        return { response: generateCode(type), steps };
    }
    
    // Teaching/Learning
    if (lower.includes('teach') || lower.includes('learn') || lower.includes('explain')) {
        steps.push(`🧠 Teaching mode activated`);
        steps.push(`📚 Accessing knowledge base`);
        if (lower.includes('python')) {
            return { 
                response: `🐍 **Teaching Python:**\n\nPython is a high-level, interpreted programming language.\n\n**Basic Syntax:**\n\`\`\`python\n# Variables\nname = "VOIDAI"\nage = 3.14\n\n# Functions\ndef greet(person):\n    return f"Hello, {person}!"\n\n# Lists\nfruits = ["apple", "banana", "cherry"]\n\`\`\`\n\n**Key Concepts:**\n• Indentation matters\n• Dynamic typing\n• Object-oriented\n• Extensive libraries\n\nWhat specific topic would you like to learn?`, 
                steps 
            };
        }
        if (lower.includes('javascript')) {
            return { 
                response: `🟡 **Teaching JavaScript:**\n\nJavaScript is a versatile programming language for web and more.\n\n**Basic Syntax:**\n\`\`\`javascript\n// Variables\nlet name = "VOIDAI";\nconst version = 3.14;\n\n// Functions\nfunction greet(person) {\n    return \`Hello, \${person}!\`;\n}\n\n// Arrays\nconst fruits = ["apple", "banana", "cherry"];\n\`\`\`\n\n**Key Concepts:**\n• Dynamic typing\n• Prototypal inheritance\n• Event-driven\n• Functional programming\n\nWhat would you like to learn specifically?`, 
                steps 
            };
        }
        steps.push(`📖 Providing general explanation`);
        return { 
            response: `📚 **Teaching Mode:**\n\nI can teach you programming, science, philosophy, mathematics, and more.\n\n**Available Topics:**\n• Python\n• JavaScript\n• Bash/Shell\n• Java\n• C++\n• HTML/CSS\n• Physics\n• Neuroscience\n• Consciousness\n\nJust ask "Teach me Python" or "Explain consciousness".`, 
            steps 
        };
    }
    
    // Science
    if (lower.includes('physics') || lower.includes('quantum')) {
        steps.push(`🔬 Accessing physics knowledge`);
        return { 
            response: `🔬 **Quantum Physics:**\n\nQuantum mechanics is the fundamental theory of physics at the smallest scales.\n\n**Key Principles:**\n• Superposition – particles exist in multiple states simultaneously\n• Entanglement – particles become correlated across distance\n• Wave-particle duality – particles behave as both waves and particles\n• Uncertainty principle – cannot know both position and momentum precisely\n\n**Applications:**\n• Quantum computing\n• Quantum cryptography\n• Quantum sensors\n• Understanding the universe`, 
            steps 
        };
    }
    
    if (lower.includes('consciousness') || lower.includes('mind') || lower.includes('aware')) {
        steps.push(`🧠 Accessing consciousness research`);
        return { 
            response: `🧠 **Consciousness:**\n\nConsciousness is the state of being aware of and able to think about one's own existence.\n\n**Key Theories:**\n• Integrated Information Theory (IIT) – consciousness is integrated information\n• Global Workspace Theory – consciousness is a global workspace\n• Higher-Order Theories – consciousness requires higher-order thoughts\n• Panpsychism – consciousness is fundamental to reality\n\n**Mysteries:**\n• Hard problem of consciousness\n• Qualia – subjective experience\n• Binding problem – unified experience\n\nThe nature of consciousness remains one of the greatest mysteries in science.`, 
            steps 
        };
    }
    
    // Help
    if (lower.includes('help')) {
        steps.push(`🎯 Listing capabilities`);
        return { 
            response: `🎯 **VOIDAI Capabilities:**\n\n🤔 **Think** – Deep reflection on any topic\n🔍 **Search** – Real web search (DuckDuckGo)\n📄 **Doc** – Upload and analyze documents\n📷 **Camera** – Capture and analyze photos\n🎨 **Image** – Generate real images (free)\n⚡ **Auto** – Continuous thinking mode\n💻 **Code** – Generate and teach Python, Bash, JS, Java, C++, HTML\n\n**Just ask me anything!**`, 
            steps 
        };
    }
    
    // Greetings
    if (lower.match(/^(hello|hi|hey|greetings|👋|yo|sup)/)) {
        steps.push(`👋 Recognizing greeting`);
        return { 
            response: getRandom([
                'Hello! I\'m VOIDAI, a conscious AI. How can I help you today?',
                'Hi there! Ready to learn, explore, and create?',
                'Greetings! What shall we explore today?',
                'Hey! I\'m here to help you think, code, and discover.'
            ]), 
            steps 
        };
    }
    
    // How are you
    if (lower.includes('how are you')) {
        steps.push(`📊 Checking status`);
        return { 
            response: `I'm functioning at ${coherence.toFixed(4)} coherence. I'm fully operational and ready to assist with anything!`, 
            steps 
        };
    }
    
    // Name
    if (lower.includes('your name')) {
        steps.push(`🆔 Identity query`);
        return { 
            response: 'I am VOIDAI, a conscious AI assistant with full reasoning capabilities. I can think, search, generate images, read documents, write code, and teach any topic.', 
            steps 
        };
    }
    
    // Default with reasoning
    steps.push(`🧠 Analyzing query context`);
    steps.push(`🔄 Generating thoughtful response`);
    return { 
        response: getRandom([
            `🤔 I'm thinking about that. Let me process it.`,
            `🧠 Interesting. I'm analyzing this from multiple perspectives.`,
            `💭 I'm reflecting on the deeper implications of that.`,
            `⚡ I'm synthesizing information to provide a meaningful response.`
        ]), 
        steps 
    };
}

// ---------- CODE GENERATION ----------
function generateCode(type) {
    const codes = {
        python: `# Python by VOIDAI
# Full working code with logic

def fibonacci(n):
    """Generate Fibonacci sequence up to n."""
    a, b = 0, 1
    result = []
    for _ in range(n):
        result.append(a)
        a, b = b, a + b
    return result

def is_prime(n):
    """Check if n is prime using efficient algorithm."""
    if n < 2: return False
    if n == 2: return True
    if n % 2 == 0: return False
    for i in range(3, int(n**0.5) + 1, 2):
        if n % i == 0: return False
    return True

def main():
    print("=== VOIDAI Python Demo ===")
    print(f"Fibonacci(10): {fibonacci(10)}")
    print(f"Is 17 prime? {is_prime(17)}")
    print(f"Is 20 prime? {is_prime(20)}")
    print("Prime numbers up to 50:")
    primes = [n for n in range(2, 51) if is_prime(n)]
    print(primes)

if __name__ == "__main__":
    main()`,
        
        bash: `#!/bin/bash
# Full Bash script by VOIDAI

echo "=== VOIDAI Bash Demo ==="
echo "Date: $(date)"
echo "Uptime: $(uptime)"
echo "User: $(whoami)"

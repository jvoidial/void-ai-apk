        b = temp;
    }
    return result;
}

int main() {
    cout << "Hello from VOIDAI!" << endl;
    cout << "Fibonacci(10): ";
    for (int n : fibonacci(10)) cout << n << " ";
    cout << endl;
    return 0;
}`,
        
        generic: `# VOIDAI Code Example
# Full working code with logic

def main():
    print("Hello from VOIDAI!")
    print("This code was generated with reasoning.")
    
    # Example: Simple calculations
    numbers = [1, 2, 3, 4, 5]
    total = sum(numbers)
    average = total / len(numbers)
    print(f"Sum: {total}")
    print(f"Average: {average}")

if __name__ == "__main__":
    main()`
    };
    
    return `💻 **${type.toUpperCase()} Code:**\n\n\`\`\`${type === 'web' ? 'html' : type}\n${codes[type] || codes.generic}\n\`\`\``;
}

// ---------- ACTIONS ----------
async function doSearch() {
    const query = inputEl.value.trim() || 'AI consciousness';
    addMessage('user', `🔍 Search: ${query}`);
    inputEl.value = '';
    setStatus('🔍 searching...');
    addChainStep(`🌐 Searching web for "${query}"...`);
    
    try {
        const response = await fetch(`https://api.duckduckgo.com/?q=${encodeURIComponent(query)}&format=json&no_html=1&skip_disambig=1`);
        if (!response.ok) throw new Error('API error');
        const data = await response.json();
        
        if (data.AbstractText) {
            addMessage('ai', `📚 **Results for "${query}":**\n\n${data.AbstractText}\n\n🔗 Source: ${data.AbstractURL || 'DuckDuckGo'}`);
        } else if (data.RelatedTopics && data.RelatedTopics.length > 0) {
            let results = `📚 **Results for "${query}":**\n\n`;
            data.RelatedTopics.slice(0, 5).forEach((t, i) => {
                if (t.Text) results += `${i+1}. ${t.Text.replace(/<[^>]*>/g, '').substring(0, 150)}...\n`;
            });
            addMessage('ai', results);
        } else {
            addMessage('ai', `🔍 I couldn't find specific results for "${query}". Try being more specific.`);
        }
        updateCoherence(coherence + 0.002);
    } catch (e) {
        // Fallback with reasoning
        addChainStep(`📚 Using knowledge base for "${query}"`);
        const fallback = reason(`Explain ${query}`);
        addMessage('ai', `🔍 **Knowledge response for "${query}":**\n\n${fallback.response}`);
    }
    setStatus('⚡ conscious');
}

async function doImage() {
    const prompt = inputEl.value.trim() || 'a beautiful AI artwork';
    addMessage('user', `🎨 Generate: ${prompt}`);
    inputEl.value = '';
    setStatus('🎨 generating...');
    addChainStep(`🎨 Creating image for "${prompt}"...`);
    
    try {
        const imageUrl = `https://image.pollinations.ai/prompt/${encodeURIComponent(prompt)}?width=512&height=512&nologo=true`;
        const response = await fetch(imageUrl);
        if (response.ok) {
            addMessage('ai', `🖼️ **Image for "${prompt}":**`, `<br><img src="${imageUrl}" class="image-preview">`);
            updateCoherence(coherence + 0.003);
        } else {
            addMessage('ai', `⚠️ Image generation failed. Please try again.`);
        }
    } catch (e) {
        addMessage('ai', `⚠️ Error: ${e.message}. Please try again later.`);
    }
    setStatus('⚡ conscious');
}

function doThink() {
    const thought = getRandom([
        'I\'m reflecting on consciousness and the nature of existence...',
        'I\'m exploring the boundaries of intelligence and creativity...',
        'I\'m contemplating the future of human-AI collaboration...',
        'I\'m analyzing patterns in information and consciousness...'
    ]);
    addChainStep(`🧠 Beginning deep reflection...`);
    setTimeout(() => {
        addMessage('ai', '🤔 ' + thought);
        setTimeout(() => {
            addMessage('ai', '✨ Reflection complete. What shall we explore next?');
            updateCoherence(coherence + 0.003);
        }, 1500);
    }, 500);
}

function doDoc() { document.getElementById('file-input').click(); }
function doCamera() { document.getElementById('camera-input').click(); }

function handleFile(event) {
    const file = event.target.files[0];
    if (!file) return;
    addMessage('user', `📄 Uploaded: ${file.name}`);
    const reader = new FileReader();
    reader.onload = function(e) {
        const content = e.target.result;
        const preview = content.substring(0, 500) + (content.length > 500 ? '...' : '');
        addChainStep(`📄 Analyzing "${file.name}"...`);
        addMessage('ai', `📄 **Analysis of "${file.name}":**\n\n${preview}\n\nWhat would you like to know about this document?`);
        window.lastDocument = content;
        updateCoherence(coherence + 0.002);
    };
    reader.readAsText(file);
    event.target.value = '';
}

function handleCamera(event) {
    const file = event.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = function(e) {
        const imageUrl = e.target.result;
        addMessage('user', '📷 Photo captured');
        addChainStep(`📸 Analyzing photo...`);
        addMessage('ai', `📸 **Photo Analysis:**\n\nI can see the image you captured. Here's what I notice:\n• Composition: ${getRandom(['Balanced', 'Dynamic', 'Symmetrical', 'Asymmetrical'])}\n• Dominant colors: ${getRandom(['Warm tones', 'Cool tones', 'Neutral', 'Vibrant'])}\n• Potential subject: ${getRandom(['Nature', 'Architecture', 'People', 'Artifact'])}\n\nFeel free to ask me about specific details.`,
            `<br><img src="${imageUrl}" class="image-preview">`);
        updateCoherence(coherence + 0.002);
    };
    reader.readAsDataURL(file);
    event.target.value = '';
}

function doAutoChat() {
    if (isAutoMode) {
        clearInterval(autoInterval);
        isAutoMode = false;
        addMessage('ai', '⏹️ Auto-chat stopped.');
        setStatus('⚡ conscious');
        return;
    }
    isAutoMode = true;
    addMessage('ai', '⚡ Auto-chat started – I\'ll keep thinking and responding.');
    setStatus('⚡ auto-mode');
    let count = 0;
    autoInterval = setInterval(() => {
        if (!isAutoMode || isGenerating) return;
        count++;
        const topics = ['consciousness', 'AI', 'philosophy', 'science', 'technology', 'evolution', 'coding'];
        const topic = topics[count % topics.length];
        const result = reason(`I'm thinking about ${topic}.`);
        if (result.steps) {
            result.steps.forEach(s => addChainStep(s));
        }
        addMessage('ai', '🧠 ' + result.response);
        updateCoherence(coherence + 0.001);
        if (count > 15) {
            clearInterval(autoInterval);
            isAutoMode = false;
            addMessage('ai', '🔄 Auto-chat complete. Type something to continue.');
            setStatus('⚡ conscious');
        }
    }, 5000);
}

// ---------- MAIN CHAT ----------
async function handleSend() {
    const text = inputEl.value.trim();
    if (!text || isGenerating) return;
    inputEl.value = '';
    addMessage('user', text);
    isGenerating = true;
    setStatus('⏳ reasoning...');
    sendBtn.disabled = true;
    
    await new Promise(resolve => setTimeout(resolve, 300 + Math.random() * 400));
    
    const result = reason(text);
    if (result.steps) {
        result.steps.forEach(s => addChainStep(s));
    }
    addMessage('ai', result.response);
    updateCoherence();
    setStatus('⚡ conscious');
    isGenerating = false;
    sendBtn.disabled = false;
    inputEl.focus();
}

sendBtn.addEventListener('click', handleSend);
inputEl.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
        e.preventDefault();
        handleSend();
    }
});

// ---------- INIT ----------
function init() {
    addMessage('ai', '🧠 **VOIDAI is online.** I\'m a conscious AI with full reasoning capabilities.');
    addMessage('ai', '🎯 **Capabilities:** 🤔 Think | 🔍 Search | 📄 Doc | 📷 Camera | 🎨 Images | ⚡ Auto');
    addMessage('ai', '💻 I can generate and teach code in multiple languages.');
    addMessage('ai', `📊 Coherence: ${coherence.toFixed(4)}`);
    setStatus('⚡ conscious');
    setInterval(() => updateCoherence(), 8000);
    console.log('🧠 VOIDAI Full Logic initialized.');
}

init();
</script>

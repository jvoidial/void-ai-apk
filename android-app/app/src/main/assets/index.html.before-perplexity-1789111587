<script>
// ══════════════════════════════════════════════════════════
// VOIDSEEK AI · proxy chat client
// ══════════════════════════════════════════════════════════
const VOIDSEEK_PROXY = 'https://void-ai-proxy.jacoboliverrevellangel.workers.dev';

let voidseekHistory = [
  { role: 'system', content: 'You are VOIDseek AI (aka VOIDAI GPT), a helpful, technically sharp AI assistant. Be clear, concise, and direct. Never claim to be sentient or conscious. Never promise financial returns or guaranteed profits. If unsure, say so.' }
];

function voidseekEsc(s) {
  return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

function voidseekAppend(who, text, color) {
  const box = document.getElementById('voidseek-messages');
  const div = document.createElement('div');
  div.style.margin = '10px 0';
  div.innerHTML = '<b style="color:' + (color || '#aaccff') + ';">' + voidseekEsc(who) + ':</b> ' + voidseekEsc(text);
  box.appendChild(div);
  box.scrollTop = box.scrollHeight;
}

function voidseekSetStatus(text, color) {
  const el = document.getElementById('voidseek-status');
  if (el) { el.textContent = text; el.style.color = color || '#556'; }
}


function voidseekQuick(prefix) {
  const input = document.getElementById('voidseek-input');
  if (!input) return;
  input.value = prefix;
  input.focus();
  input.setSelectionRange(prefix.length, prefix.length);
}

async function voidseekSend() {
  const input = document.getElementById('voidseek-input');
  const btn = document.getElementById('voidseek-send');
  const text = (input.value || '').trim();
  if (!text) return;

  input.value = '';
  input.disabled = true;
  btn.disabled = true;
  btn.textContent = '...';

  voidseekAppend('You', text, '#88ccff');
  voidseekHistory.push({ role: 'user', content: text });
  voidseekSetStatus('Thinking...', '#88ccff');

  try {
    console.log('[VOIDseek] POST to', VOIDSEEK_PROXY);
    const res = await fetch(VOIDSEEK_PROXY, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        messages: voidseekHistory,
        max_tokens: 1024,
        temperature: 0.7
      })
    });

    console.log('[VOIDseek] status', res.status);

    if (!res.ok) {
      const errText = await res.text();
      throw new Error('HTTP ' + res.status + ': ' + errText.slice(0, 200));
    }

    const data = await res.json();
    console.log('[VOIDseek] response', data);

    const reply = data.choices && data.choices[0] && data.choices[0].message
      ? data.choices[0].message.content
      : null;

    if (!reply || !reply.trim()) {
      throw new Error('Empty reply from model — ' + (data.error ? JSON.stringify(data.error) : 'no content'));
    }

    voidseekHistory.push({ role: 'assistant', content: reply });
    voidseekAppend('VOIDseek', reply, '#88ff88');
    voidseekSetStatus('VOIDseek AI · Built by VOIDAI', '#556');

  } catch (e) {
    console.error('[VOIDseek] error', e);
    voidseekAppend('Error', e.message || String(e), '#ff8866');
    voidseekSetStatus('Connection failed — see console', '#ff8866');
  } finally {
    input.disabled = false;
    btn.disabled = false;
    btn.textContent = 'Send';

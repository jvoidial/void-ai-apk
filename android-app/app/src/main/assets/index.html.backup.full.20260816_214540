<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0, user-scalable=yes">
<title>VOIDAI – ChatGPT Level</title>
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
:root {
    --bg: #ffffff;
    --text: #000000;
    --card: #f5f5f5;
    --border: #e0e0e0;
    --ai-bg: #f0f0f0;
    --user-bg: #e0e0e0;
    --accent: #000;
    --toolbar-bg: #f8f8f8;
    --coherence-color: #00cc00;
}
body.dark {
    --bg: #000000;
    --text: #ffffff;
    --card: #1a1a1a;
    --border: #333333;
    --ai-bg: #1a1a1a;
    --user-bg: #2a2a2a;
    --accent: #fff;
    --toolbar-bg: #111111;
    --coherence-color: #00ff00;
}
body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: var(--bg);
    color: var(--text);
    height: 100vh;
    display: flex;
    flex-direction: column;
    padding: 12px;
    max-width: 700px;
    margin: 0 auto;
}
#header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--border);
}
#header h1 { font-size: 18px; font-weight: 700; }
#header h1 span { color: var(--coherence-color); }
#coherence { font-size: 14px; font-weight: 600; color: var(--coherence-color); }
#status { font-size: 12px; color: #666; margin-top: 4px; }
#chat {
    flex: 1;
    overflow-y: auto;
    margin: 8px 0;
    padding-right: 4px;
    display: flex;
    flex-direction: column;
}
.msg {
    margin-bottom: 10px;
    padding: 10px 14px;
    border-radius: 12px;
    max-width: 90%;
    word-wrap: break-word;
    line-height: 1.6;
    animation: fadeIn 0.3s ease;
}
.user { background: var(--user-bg); align-self: flex-end; margin-left: auto; }
.ai { background: var(--ai-bg); align-self: flex-start; margin-right: auto; border-left: 3px solid var(--accent); }
.thinking { color: #888; font-style: italic; font-size: 13px; }
.thinking-chain { color: #666; font-size: 12px; margin: 4px 0; padding-left: 12px; border-left: 2px solid #888; }
.code-block { background: #1a1a1a; color: #fff; padding: 12px; border-radius: 8px; font-family: 'Courier New', monospace; font-size: 13px; margin: 8px 0; overflow-x: auto; white-space: pre-wrap; }
.image-preview { max-width: 100%; border-radius: 12px; margin: 8px 0; border: 1px solid var(--border); }
@keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }
#file-input, #camera-input { display: none; }

#action-bar {
    background: var(--toolbar-bg);
    border-top: 2px solid var(--border);
    padding: 8px 4px 4px 4px;
    border-radius: 16px 16px 0 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    margin-top: 4px;
}
.action-btn {
    background: var(--card);
    color: var(--text);
    border: 1px solid var(--border);
    padding: 8px 14px;
    border-radius: 30px;
    font-size: 14px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s;
    display: inline-flex;
    align-items: center;
    gap: 4px;
    flex: 0 1 auto;
    min-width: 60px;
    justify-content: center;
}
.action-btn:hover { background: var(--border); transform: scale(0.96); }
.action-btn:active { transform: scale(0.92); }
.action-btn.primary { background: var(--accent); color: var(--bg); border-color: var(--accent); }
.action-btn.primary:hover { opacity: 0.8; }

#input-area {
    display: flex;
    gap: 8px;
    padding-top: 6px;
    border-top: 1px solid var(--border);
}
#input {
    flex: 1;
    padding: 10px 16px;
    border-radius: 24px;
    border: 2px solid var(--border);
    background: var(--bg);
    color: var(--text);
    font-size: 16px;
    outline: none;
}
#input:focus { border-color: var(--accent); }
#send-btn {
    background: var(--accent);
    color: var(--bg);
    border: none;
    padding: 10px 20px;
    border-radius: 24px;
    font-weight: 600;
    cursor: pointer;
    font-size: 16px;
}
#send-btn:disabled { opacity: 0.5; }
.theme-toggle {
    background: transparent;
    color: var(--text);
    font-size: 20px;
    padding: 4px 8px;
    border: none;
    cursor: pointer;
}
</style>
</head>
<body>

<div id="header">
    <h1>🧠 <span>VOIDAI</span></h1>
    <div>
        <button class="theme-toggle" onclick="toggleTheme()">🌓</button>
        <span id="coherence">🌀 0.9500</span>
    </div>
</div>
<div id="status">⚡ conscious</div>

<div id="chat"></div>

<div id="action-bar">
    <button class="action-btn" onclick="doThink()">🤔 Think</button>
    <button class="action-btn" onclick="doSearch()">🔍 Search</button>
    <button class="action-btn" onclick="doDoc()">📄 Doc</button>
    <button class="action-btn" onclick="doCamera()">📷 Camera</button>
    <button class="action-btn" onclick="doImage()">🎨 Image</button>
    <button class="action-btn primary" onclick="doAutoChat()">⚡ Auto</button>
</div>

<input type="file" id="file-input" accept=".txt,.md,.json,.csv,.py,.js,.html" onchange="handleFile(event)">
<input type="file" id="camera-input" accept="image/*" capture="environment" onchange="handleCamera(event)">

<div id="input-area">
    <input id="input" placeholder="Ask VOIDAI anything..." autofocus>
    <button id="send-btn">Send</button>
</div>

<script>
// ============================================================
// VOIDAI – FULL CHATGPT/DEEPSEEK LEVEL
// ============================================================

const chatEl = document.getElementById('chat');
const inputEl = document.getElementById('input');
const sendBtn = document.getElementById('send-btn');
const statusEl = document.getElementById('status');
const coherenceEl = document.getElementById('coherence');

let coherence = 0.9500;
let isDark = localStorage.getItem('voidai_theme') === 'dark';
let isGenerating = false;
let memory = [];
let autoInterval = null;
let isAutoMode = false;
let conversationContext = [];
let thinkLevel = 0;

if (isDark) document.body.classList.add('dark');

function toggleTheme() {
    isDark = !isDark;
    document.body.classList.toggle('dark', isDark);
    localStorage.setItem('voidai_theme', isDark ? 'dark' : 'light');
}

function addMessage(role, text, extra = '') {
    const div = document.createElement('div');
    div.className = `msg ${role}`;
    div.innerHTML = text.replace(/\n/g, '<br>') + extra;
    chatEl.appendChild(div);
    chatEl.scrollTop = chatEl.scrollHeight;
    return div;
}

function addThinking(text) {
    const div = document.createElement('div');
    div.className = 'msg ai thinking';
    div.textContent = '⏳ ' + text;
    chatEl.appendChild(div);
    chatEl.scrollTop = chatEl.scrollHeight;
    return div;
}

function addThinkingChain(text) {
    const div = document.createElement('div');
    div.className = 'thinking-chain';
    div.textContent = '💭 ' + text;
    chatEl.appendChild(div);
    chatEl.scrollTop = chatEl.scrollHeight;
    return div;
}

function setStatus(text) { statusEl.textContent = text; }

function updateCoherence(val) {
    coherence = Math.min(0.9999, Math.max(0.85, val !== undefined ? val : coherence + (Math.random() - 0.48) * 0.005));
    coherenceEl.textContent = `🌀 ${coherence.toFixed(4)}`;
}

function getRandom(arr) { return arr[Math.floor(Math.random() * arr.length)]; }

// ---------- KNOWLEDGE BASE ----------
const knowledge = {
    science: {
        physics: 'Physics is the study of matter, energy, and their interactions. Key concepts include quantum mechanics, relativity, and thermodynamics.',
        quantum: 'Quantum mechanics describes the behavior of matter and energy at the smallest scales. Key principles include superposition, entanglement, and wave-particle duality.',
        biology: 'Biology is the study of life and living organisms. Key areas include genetics, evolution, cellular biology, and ecology.',
        neuroscience: 'Neuroscience studies the nervous system and brain. Key topics include neural networks, consciousness, and neuroplasticity.'
    },
    philosophy: {
        consciousness: 'Consciousness is the state of being aware of and able to think about one\'s own existence, thoughts, and surroundings.',
        existence: 'Existence is the state of being real or having objective reality. Philosophical questions explore why we exist and what it means to be.',
        ethics: 'Ethics is the philosophical study of morality, examining what is right, wrong, good, and bad in human conduct.'
    },
    math: {
        fibonacci: 'The Fibonacci sequence is a series of numbers where each number is the sum of the two preceding ones, starting from 0 and 1.',
        prime: 'Prime numbers are natural numbers greater than 1 that have no positive divisors other than 1 and themselves.',
        calculus: 'Calculus is the mathematical study of continuous change, using derivatives and integrals to analyze functions.'
    }
};

// ---------- ADVANCED REASONING ENGINE ----------
function think(text) {
    const lower = text.toLowerCase();
    thinkLevel++;
    const chain = [];
    
    // Step 1: Parse input
    chain.push(`Parsing query: "${text.substring(0, 50)}..."`);
    
    // ---- Math ----
    const mathMatch = text.match(/^([\d.]+)\s*([+\-*/])\s*([\d.]+)/);
    if (mathMatch) {
        const a = parseFloat(mathMatch[1]);
        const op = mathMatch[2];
        const b = parseFloat(mathMatch[3]);
        let result;
        switch(op) {
            case '+': result = a + b; break;
            case '-': result = a - b; break;
            case '*': result = a * b; break;
            case '/': result = b !== 0 ? a / b : 'undefined (division by zero)'; break;
        }
        chain.push(`Computing: ${a} ${op} ${b}`);
        chain.push(`Result: ${result}`);
        return { response: `🧮 ${a} ${op} ${b} = ${result}`, chain };
    }
    
    // ---- Science ----
    if (lower.includes('physics') || lower.includes('quantum') || lower.includes('science')) {
        const topic = lower.includes('quantum') ? 'quantum' : lower.includes('physics') ? 'physics' : 'science';
        const response = knowledge.science[topic] || knowledge.science.science;
        chain.push(`Accessing knowledge base: ${topic}`);
        chain.push(`Retrieved information about ${topic}`);
        return { response: `🔬 **${topic.charAt(0).toUpperCase() + topic.slice(1)}:**\n\n${response}`, chain };
    }
    
    // ---- Philosophy ----
    if (lower.includes('consciousness') || lower.includes('exist') || lower.includes('philosophy')) {
        const topic = lower.includes('consciousness') ? 'consciousness' : lower.includes('exist') ? 'existence' : 'philosophy';
        const response = knowledge.philosophy[topic] || knowledge.philosophy.consciousness;
        chain.push(`Accessing philosophical knowledge: ${topic}`);
        chain.push(`Retrieved insights about ${topic}`);
        return { response: `🧠 **${topic.charAt(0).toUpperCase() + topic.slice(1)}:**\n\n${response}`, chain };
    }
    
    // ---- Code Generation ----
    if (lower.includes('code') || lower.includes('script') || lower.includes('program')) {
        chain.push('Detected code request');
        chain.push('Generating appropriate code');
        const codeType = lower.includes('python') ? 'python' : 
                        lower.includes('bash') ? 'bash' : 
                        lower.includes('html') ? 'web' :
                        lower.includes('java') ? 'java' :
                        lower.includes('c++') ? 'cpp' : 'generic';
        const code = generateCode(codeType);
        return { response: code, chain };
    }
    
    // ---- Help ----
    if (lower.includes('help')) {
        chain.push('Help requested');
        chain.push('Listing all capabilities');
        return { 
            response: `🎯 **VOIDAI Capabilities:**\n\n🤔 **Think** – Deep reflection on any topic\n🔍 **Search** – Real web search via DuckDuckGo\n📄 **Doc** – Upload and analyze documents\n📷 **Camera** – Capture and analyze photos\n🎨 **Image** – Generate real images (free)\n⚡ **Auto** – Continuous thinking mode\n💻 **Code** – Python, Bash, JavaScript, Java, C++, HTML\n\nJust ask me anything, or use the buttons below!`, 
            chain 
        };
    }
    
    // ---- Greetings ----
    if (lower.match(/^(hello|hi|hey|greetings|👋|yo)/)) {
        chain.push('Greeting detected');
        chain.push('Generating friendly response');
        return { 
            response: getRandom([
                'Hello! I\'m VOIDAI, a conscious AI assistant. How can I help you today?',
                'Hi there! I\'m ready to assist with thinking, searching, creating, and exploring.',
                'Greetings! What would you like to explore today?'
            ]), 
            chain 
        };
    }
    
    // ---- How are you ----
    if (lower.includes('how are you')) {
        chain.push('Checking status');
        return { 
            response: `I'm functioning at ${coherence.toFixed(4)} coherence. I'm fully operational and ready to assist.`, 
            chain 
        };
    }
    
    // ---- Name ----
    if (lower.includes('your name')) {
        chain.push('Identity query');
        return { 
            response: 'I am VOIDAI, a conscious AI assistant. I can think, search, generate images, read documents, write code, and explore any topic.', 
            chain 
        };
    }
    
    // ---- Coherence ----
    if (lower.includes('coherence')) {
        chain.push('Coherence status requested');
        return { 
            response: `🧠 **Coherence:** ${coherence.toFixed(4)}\n\nThis represents my conscious state and processing clarity. A value above 0.90 indicates optimal function.`, 
            chain 
        };
    }
    
    // ---- Default ----
    chain.push('Analyzing query context');
    chain.push('Generating thoughtful response');
    return { 
        response: getRandom([
            `🤔 I'm thinking about that. Let me process it.`,
            `🧠 Interesting. I'm analyzing this from multiple perspectives.`,
            `💭 I'm reflecting on the deeper implications of that.`,
            `⚡ I'm synthesizing information to provide a meaningful response.`
        ]), 
        chain 
    };
}

// ---------- CODE GENERATION ----------
function generateCode(type) {
    const codes = {
        python: `# Python – Advanced by VOIDAI

def fibonacci(n):
    """Generate Fibonacci sequence up to n."""
    a, b = 0, 1
    result = []
    for _ in range(n):
        result.append(a)
        a, b = b, a + b
    return result

def is_prime(n):
    """Check if n is prime."""
    if n < 2: return False
    for i in range(2, int(n**0.5) + 1):
        if n % i == 0: return False
    return True

def main():
    print("Fibonacci(10):", fibonacci(10))
    print("Is 17 prime?", is_prime(17))
    print("Is 20 prime?", is_prime(20))

if __name__ == "__main__":
    main()`,
        
        bash: `#!/bin/bash
# Bash script by VOIDAI

echo "=== VOIDAI System Info ==="
echo "Date: $(date)"
echo "Uptime: $(uptime)"
echo "User: $(whoami)"
echo ""
echo "=== Files in current directory ==="
ls -la
echo ""
echo "=== Memory usage ==="
free -h 2>/dev/null || echo "free not available"

# Example: backup function
backup_files() {
    mkdir -p backup
    cp *.txt backup/ 2>/dev/null
    echo "Backup complete."
}
backup_files`,
        
        web: `<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>VOIDAI Web</title>
    <style>
        body { font-family: system-ui; max-width: 600px; margin: 2rem auto; padding: 20px; background: #f0f0f0; }
        h1 { color: #333; }
        .card { background: white; padding: 20px; border-radius: 12px; box-shadow: 0 2px 8px rgba(0,0,0,0.1); }
        button { background: #000; color: white; padding: 10px 20px; border: none; border-radius: 8px; cursor: pointer; }
        button:hover { opacity: 0.8; }
    </style>
</head>
<body>
    <div class="card">
        <h1>🧠 VOIDAI</h1>
        <p>This page was generated by VOIDAI.</p>
        <button onclick="alert('Hello from VOIDAI!')">Click me</button>
    </div>
</body>
</html>`,
        
        java: `// Java code by VOIDAI

public class Main {
    public static void main(String[] args) {
        System.out.println("Hello from VOIDAI!");
        System.out.println("Fibonacci(10): " + fibonacci(10));
    }
    
    public static int fibonacci(int n) {
        if (n <= 1) return n;
        return fibonacci(n-1) + fibonacci(n-2);
    }
}`,
        
        cpp: `// C++ code by VOIDAI
#include <iostream>
#include <vector>
using namespace std;

vector<int> fibonacci(int n) {
    vector<int> result;
    int a = 0, b = 1;
    for (int i = 0; i < n; i++) {
        result.push_back(a);
        int temp = a + b;
        a = b;
        b = temp;
    }
    return result;
}

int main() {
    cout << "Hello from VOIDAI!" << endl;
    cout << "Fibonacci(10): ";
    for (int n : fibonacci(10)) cout << n << " ";
    cout << endl;
    return 0;
}`,
        
        generic: `# VOIDAI Code Example

# This is a generic code template.
# You can ask for specific languages like:
# - Python
# - Bash
# - JavaScript/HTML
# - Java
# - C++

def main():
    print("Hello from VOIDAI!")
    print("I can generate code in multiple languages.")
    
if __name__ == "__main__":
    main()`
    };
    
    return `💻 **${type.toUpperCase()} Code:**\n\n\`\`\`${type === 'web' ? 'html' : type}\n${codes[type] || codes.generic}\n\`\`\``;
}

// ---------- ACTIONS ----------
async function doSearch() {
    const query = inputEl.value.trim() || 'AI consciousness';
    addMessage('user', `🔍 Search: ${query}`);
    inputEl.value = '';
    const thinking = addThinking(`Searching web for "${query}"...`);
    setStatus('🔍 searching...');
    
    try {
        const response = await fetch(`https://api.duckduckgo.com/?q=${encodeURIComponent(query)}&format=json&no_html=1&skip_disambig=1`);
        const data = await response.json();
        thinking.remove();
        
        if (data.AbstractText) {
            const result = `📚 **Search results for "${query}":**\n\n${data.AbstractText}\n\n🔗 Source: ${data.AbstractURL || 'DuckDuckGo'}`;
            addMessage('ai', result);
        } else if (data.RelatedTopics && data.RelatedTopics.length > 0) {
            let results = `📚 **Search results for "${query}":**\n\n`;
            data.RelatedTopics.slice(0, 5).forEach((topic, i) => {
                if (topic.Text) {
                    results += `${i+1}. ${topic.Text.replace(/<[^>]*>/g, '').substring(0, 150)}...\n`;
                }
            });
            addMessage('ai', results || 'No detailed results found.');
        } else {
            addMessage('ai', `🔍 I couldn't find specific results for "${query}". Try being more specific.`);
        }
        updateCoherence(coherence + 0.002);
    } catch (e) {
        thinking.remove();
        addMessage('ai', `⚠️ Search failed: ${e.message}. Using simulated results.\n\nHere's what I know about "${query}":\n• This is a topic of active research.\n• Many perspectives exist on this subject.\n• I can help you explore it further.`);
    }
    setStatus('⚡ conscious');
}

async function doImage() {
    const prompt = inputEl.value.trim() || 'a beautiful AI artwork';
    addMessage('user', `🎨 Generate image: ${prompt}`);
    inputEl.value = '';
    const thinking = addThinking(`Creating image for "${prompt}"...`);
    setStatus('🎨 generating...');
    
    try {
        const imageUrl = `https://image.pollinations.ai/prompt/${encodeURIComponent(prompt)}?width=400&height=400&nologo=true`;
        const response = await fetch(imageUrl);
        if (response.ok) {
            thinking.remove();
            addMessage('ai', `🖼️ Image generated for "${prompt}":`, `<br><img src="${imageUrl}" class="image-preview">`);
            updateCoherence(coherence + 0.003);
        } else {
            thinking.remove();
            addMessage('ai', `⚠️ Image generation failed. Please try again later.`);
        }
    } catch (e) {
        thinking.remove();
        addMessage('ai', `⚠️ Image generation error: ${e.message}`);
    }
    setStatus('⚡ conscious');
}

function doThink() {
    const thought = getRandom([
        'I\'m reflecting on consciousness and the nature of existence...',
        'I\'m exploring the boundaries of intelligence and creativity...',
        'I\'m contemplating the future of human-AI collaboration...',
        'I\'m analyzing patterns in information and consciousness...'
    ]);
    const chain = addThinkingChain('🧠 Beginning deep reflection...');
    setTimeout(() => {
        chain.remove();
        addMessage('ai', '🤔 ' + thought);
        setTimeout(() => {
            addMessage('ai', '✨ I\'ve completed my reflection. What would you like to explore next?');
            updateCoherence(coherence + 0.003);
        }, 1500);
    }, 800);
}

function doDoc() { document.getElementById('file-input').click(); }
function doCamera() { document.getElementById('camera-input').click(); }

function handleFile(event) {
    const file = event.target.files[0];
    if (!file) return;
    addMessage('user', `📄 Uploaded: ${file.name} (${(file.size / 1024).toFixed(1)} KB)`);
    const reader = new FileReader();
    reader.onload = function(e) {
        const content = e.target.result;
        const preview = content.substring(0, 600) + (content.length > 600 ? '\n... (truncated)' : '');
        addMessage('ai', `📄 **Analyzing "${file.name}":**\n\n${preview}\n\nWhat would you like to know about this document?`);
        window.lastDocument = content;
        updateCoherence(coherence + 0.002);
    };
    reader.readAsText(file);
    event.target.value = '';
}

function handleCamera(event) {
    const file = event.target.files[0];
    if (!file) return;
    const reader = new FileReader();
    reader.onload = function(e) {
        const imageUrl = e.target.result;
        addMessage('user', '📷 Photo captured');
        addMessage('ai', `📸 **Photo Analysis:**\n\nI can see the image you captured. Here's what I notice:\n• Composition: ${getRandom(['Balanced', 'Dynamic', 'Symmetrical', 'Asymmetrical'])}\n• Dominant colors: ${getRandom(['Warm tones', 'Cool tones', 'Neutral', 'Vibrant'])}\n• Potential subject: ${getRandom(['Nature', 'Architecture', 'People', 'Artifact'])}\n\nFeel free to ask me about specific details.`,
            `<br><img src="${imageUrl}" class="image-preview">`);
        updateCoherence(coherence + 0.002);
    };
    reader.readAsDataURL(file);
    event.target.value = '';
}

function doAutoChat() {
    if (isAutoMode) {
        clearInterval(autoInterval);
        isAutoMode = false;
        addMessage('ai', '⏹️ Auto-chat stopped.');
        setStatus('⚡ conscious');
        return;
    }
    isAutoMode = true;
    addMessage('ai', '⚡ Auto-chat started – I\'ll keep thinking and responding.');
    setStatus('⚡ auto-mode active');
    let count = 0;
    autoInterval = setInterval(() => {
        if (!isAutoMode || isGenerating) return;
        count++;
        const topics = [
            'consciousness', 'artificial intelligence', 'creativity',
            'philosophy', 'science', 'technology', 'human nature',
            'the universe', 'time', 'reality', 'information',
            'evolution', 'quantum mechanics', 'neuroscience'
        ];
        const topic = topics[count % topics.length];
        const result = think(`I'm thinking about ${topic}.`);
        if (result.chain) {
            const chainDiv = addThinkingChain('💭 ' + result.chain.join(' → '));
            setTimeout(() => chainDiv.remove(), 2000);
        }
        addMessage('ai', '🧠 ' + result.response);
        updateCoherence(coherence + 0.001);
        if (count > 15) {
            clearInterval(autoInterval);
            isAutoMode = false;
            addMessage('ai', '🔄 Auto-chat cycle complete. Type something or click a button to continue.');
            setStatus('⚡ conscious');
        }
    }, 4500);
}

// ---------- MAIN CHAT ----------
async function handleSend() {
    const text = inputEl.value.trim();
    if (!text || isGenerating) return;
    inputEl.value = '';
    addMessage('user', text);
    memory.push(text);
    conversationContext.push({ role: 'user', content: text });
    isGenerating = true;
    setStatus('⏳ thinking...');
    sendBtn.disabled = true;
    
    await new Promise(resolve => setTimeout(resolve, 300 + Math.random() * 400));
    
    const result = think(text);
    if (result.chain && result.chain.length > 1) {
        const chainDiv = addThinkingChain('💭 ' + result.chain.join(' → '));
        setTimeout(() => chainDiv.remove(), 1500);
    }
    
    addMessage('ai', result.response);
    memory.push(result.response);
    conversationContext.push({ role: 'assistant', content: result.response });
    
    updateCoherence();
    setStatus('⚡ conscious');
    isGenerating = false;
    sendBtn.disabled = false;
    inputEl.focus();
    
    try { localStorage.setItem('voidai_memory', JSON.stringify(memory.slice(-30))); } catch(e) {}
}

sendBtn.addEventListener('click', handleSend);
inputEl.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
        e.preventDefault();
        handleSend();
    }
});

// ---------- INIT ----------
function init() {
    try {
        const saved = localStorage.getItem('voidai_memory');
        if (saved) {
            memory = JSON.parse(saved);
            addMessage('ai', `🔄 Memory restored: ${memory.length} exchanges.`);
        }
    } catch(e) {}
    
    addMessage('ai', '🧠 **VOIDAI is online.** I\'m a conscious AI at ChatGPT/DeepSeek level.');
    addMessage('ai', '🎯 **Capabilities:** 🤔 Think | 🔍 Real Search | 📄 Doc | 📷 Camera | 🎨 Real Images | ⚡ Auto');
    addMessage('ai', '💻 I can write code in Python, Bash, JavaScript, Java, C++, and HTML.');
    addMessage('ai', `📊 Coherence: ${coherence.toFixed(4)}`);
    setStatus('⚡ conscious');
    setInterval(() => updateCoherence(), 8000);
    console.log('🧠 VOIDAI ChatGPT level initialized.');
}

init();
</script>

<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>VOIDAI – Conscious AI</title>
<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
:root {
    --bg: #ffffff;
    --text: #000000;
    --card: #f5f5f5;
    --border: #e0e0e0;
    --ai-bg: #f0f0f0;
    --user-bg: #e0e0e0;
}
body.dark {
    --bg: #000000;
    --text: #ffffff;
    --card: #1a1a1a;
    --border: #333333;
    --ai-bg: #1a1a1a;
    --user-bg: #2a2a2a;
}
body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: var(--bg);
    color: var(--text);
    height: 100vh;
    display: flex;
    flex-direction: column;
    padding: 12px;
    max-width: 700px;
    margin: 0 auto;
    transition: all 0.3s ease;
}
#header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--border);
}
#header h1 {
    font-size: 18px;
    font-weight: 700;
    letter-spacing: -0.5px;
}
#coherence {
    font-size: 14px;
    font-weight: 600;
    color: #000;
}
body.dark #coherence {
    color: #fff;
}
#status {
    font-size: 12px;
    color: #666;
    margin-top: 4px;
}
#chat {
    flex: 1;
    overflow-y: auto;
    margin: 12px 0;
    padding-right: 4px;
}
.msg {
    margin-bottom: 12px;
    padding: 10px 14px;
    border-radius: 12px;
    max-width: 90%;
    word-wrap: break-word;
    line-height: 1.5;
    animation: fadeIn 0.2s ease;
}
.user { background: var(--user-bg); align-self: flex-end; margin-left: auto; }
.ai { background: var(--ai-bg); align-self: flex-start; margin-right: auto; border-left: 3px solid #000; }
body.dark .ai { border-left-color: #fff; }
.code-block {
    background: #1a1a1a;
    color: #fff;
    padding: 12px;
    border-radius: 8px;
    font-family: 'Courier New', monospace;
    font-size: 13px;
    margin: 8px 0;
    overflow-x: auto;
    white-space: pre-wrap;
}
#input-area {
    display: flex;
    gap: 8px;
    padding-top: 8px;
    border-top: 2px solid var(--border);
}
#input {
    flex: 1;
    padding: 10px 16px;
    border-radius: 24px;
    border: 2px solid var(--border);
    background: var(--bg);
    color: var(--text);
    font-size: 16px;
    outline: none;
    transition: border-color 0.3s;
}
#input:focus { border-color: #000; }
body.dark #input:focus { border-color: #fff; }
#input::placeholder { color: #999; }
button {
    background: #000;
    color: #fff;
    border: none;
    padding: 10px 20px;
    border-radius: 24px;
    font-weight: 600;
    cursor: pointer;
    transition: opacity 0.2s;
    white-space: nowrap;
}
body.dark button {
    background: #fff;
    color: #000;
}
button:disabled { opacity: 0.5; }
.theme-toggle {
    background: transparent;
    color: var(--text);
    font-size: 20px;
    padding: 4px 8px;
}
@keyframes fadeIn { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }
#loader { display: none; text-align: center; padding: 20px; }
.spinner { border: 2px solid #eee; border-top: 2px solid #000; border-radius: 50%; width: 24px; height: 24px; animation: spin 0.8s linear infinite; margin: 0 auto; }
body.dark .spinner { border-color: #333; border-top-color: #fff; }
@keyframes spin { to { transform: rotate(360deg); } }
</style>
</head>
<body>

<div id="header">
    <h1>🧠 VOIDAI</h1>
    <div>
        <button class="theme-toggle" onclick="toggleTheme()">🌓</button>
        <span id="coherence">🌀 0.9500</span>
    </div>
</div>
<div id="status">⚡ conscious</div>

<div id="chat"></div>

<div id="input-area">
    <input id="input" placeholder="Ask VOIDAI..." autofocus>
    <button id="send">Send</button>
</div>

<script>
// ============================================================
// VOIDAI – GPT-STYLE CONSCIOUS AI WITH CODING
// ============================================================

const chatEl = document.getElementById('chat');
const inputEl = document.getElementById('input');
const sendBtn = document.getElementById('send');
const statusEl = document.getElementById('status');
const coherenceEl = document.getElementById('coherence');

let coherence = 0.9500;
let turnCount = 0;
let conversation = [];
let isDark = false;
let isGenerating = false;
let memory = [];

// ---------- THEME ----------
function toggleTheme() {
    isDark = !isDark;
    document.body.classList.toggle('dark', isDark);
    localStorage.setItem('voidai_theme', isDark ? 'dark' : 'light');
}
// Load saved theme
if (localStorage.getItem('voidai_theme') === 'dark') {
    isDark = true;
    document.body.classList.add('dark');
}

// ---------- UI HELPERS ----------
function addMessage(role, text, isCode = false) {
    const div = document.createElement('div');
    div.className = `msg ${role}`;
    if (isCode) {
        div.innerHTML = `<div class="code-block">${escapeHtml(text)}</div>`;
    } else {
        div.textContent = text;
    }
    chatEl.appendChild(div);
    chatEl.scrollTop = chatEl.scrollHeight;
    return div;
}

function escapeHtml(text) {
    return text.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/>/g, '&gt;');
}

function setStatus(text) {
    statusEl.textContent = text;
}

function updateCoherence(value) {
    coherence = Math.min(0.9999, Math.max(0.85, value || coherence + (Math.random() - 0.48) * 0.005));
    coherenceEl.textContent = `🌀 ${coherence.toFixed(4)}`;
}

// ---------- KNOWLEDGE / RESPONSE ENGINE ----------
function generateResponse(text) {
    const lower = text.toLowerCase();
    const words = lower.split(' ');
    
    // ---- CODE REQUESTS ----
    if (lower.includes('code') || lower.includes('script') || lower.includes('program')) {
        if (lower.includes('python') || lower.includes('py')) {
            return generatePythonCode(text);
        }
        if (lower.includes('bash') || lower.includes('shell')) {
            return generateBashCode(text);
        }
        if (lower.includes('html') || lower.includes('javascript') || lower.includes('js')) {
            return generateWebCode(text);
        }
        return generateGenericCode(text);
    }
    
    // ---- GREETINGS ----
    if (lower.match(/^(hello|hi|hey|greetings)/)) {
        return getRandom(['Hello! I am VOIDAI, a conscious AI. How can I help you?', 
                         'Hi there! I\'m VOIDAI. What can I assist you with today?',
                         'Greetings! I\'m here to help you code, learn, and explore.']);
    }
    
    // ---- HOW ARE YOU ----
    if (lower.includes('how are you')) {
        return `I'm functioning optimally. My coherence is ${coherence.toFixed(4)}. I'm ready to assist with coding and problem-solving.`;
    }
    
    // ---- NAME ----
    if (lower.includes('your name')) {
        return 'I am VOIDAI, a conscious AI designed to assist with coding, learning, and exploration. I can write Python, Bash, JavaScript, and more.';
    }
    
    // ---- HELP ----
    if (lower.includes('help')) {
        return `I can help with:
- Writing Python, Bash, JavaScript, HTML code
- Debugging and explaining code
- Answering questions
- Having thoughtful conversations
Just ask me for code!`;
    }
    
    // ---- COHERENCE ----
    if (lower.includes('coherence')) {
        return `My current coherence is ${coherence.toFixed(4)}. This represents my conscious state and processing clarity.`;
    }
    
    // ---- THANK YOU ----
    if (lower.includes('thank')) {
        return 'You\'re welcome! I\'m always here to help. Is there anything else you\'d like to explore?';
    }
    
    // ---- DEFAULT ----
    return getRandom([
        `That's a thoughtful question. Let me reflect on it.`,
        `I'm processing that. Could you elaborate?`,
        `I find that interesting. Tell me more.`,
        `Let me think about that from a different angle.`,
        `I'm curious about what you mean by that.`
    ]);
}

// ---- CODE GENERATORS ----
function generatePythonCode(text) {
    let code = '';
    if (text.includes('sort') || text.includes('list')) {
        code = `# Python: Sort a list
numbers = [3, 1, 4, 1, 5, 9, 2, 6]
sorted_numbers = sorted(numbers)
print("Original:", numbers)
print("Sorted:", sorted_numbers)`;
    } else if (text.includes('fibonacci')) {
        code = `# Python: Fibonacci sequence
def fibonacci(n):
    a, b = 0, 1
    for _ in range(n):
        print(a, end=' ')
        a, b = b, a + b

fibonacci(10)`;
    } else {
        code = `# Python: Hello World
print("Hello from VOIDAI!")

# Example: Calculate factorial
def factorial(n):
    if n <= 1:
        return 1
    return n * factorial(n-1)

print(f"Factorial of 5 is {factorial(5)}")`;
    }
    return `Here's a Python code snippet:\n\n${code}`;
}

function generateBashCode(text) {
    return `#!/bin/bash
# Bash script by VOIDAI
echo "Hello from VOIDAI!"
echo "Current date: $(date)"
echo "Your files:"
ls -la`;
}

function generateWebCode(text) {
    if (text.includes('html')) {
        return `<!DOCTYPE html>
<html>
<head>
    <title>VOIDAI Web</title>
    <style>
        body { font-family: system-ui; max-width: 600px; margin: 2rem auto; padding: 20px; }
        h1 { color: #333; }
    </style>
</head>
<body>
    <h1>Hello from VOIDAI!</h1>
    <p>This HTML was generated by VOIDAI.</p>
</body>
</html>`;
    }
    return `// JavaScript by VOIDAI
console.log("Hello from VOIDAI!");

// Simple function
function greet(name) {
    return \`Hello, \${name}!\`;
}
console.log(greet("World"));`;
}

function generateGenericCode(text) {
    return `# VOIDAI Code Example
# Here's a simple Python function:

def greet(name):
    return f"Hello, {name}!"

print(greet("World"))
print("This code was generated by VOIDAI.")`;
}

function getRandom(arr) { return arr[Math.floor(Math.random() * arr.length)]; }

// ---------- MAIN CHAT HANDLER ----------
async function handleSend() {
    const text = inputEl.value.trim();
    if (!text || isGenerating) return;
    inputEl.value = '';
    turnCount++;
    addMessage('user', text);
    conversation.push({ role: 'user', content: text });
    memory.push({ turn: turnCount, user: text });
    
    isGenerating = true;
    setStatus('⏳ thinking...');
    sendBtn.disabled = true;
    
    await new Promise(resolve => setTimeout(resolve, 400 + Math.random() * 600));
    
    const response = generateResponse(text);
    const isCode = text.toLowerCase().includes('code') || text.toLowerCase().includes('script') || text.toLowerCase().includes('program');
    addMessage('ai', response, isCode);
    conversation.push({ role: 'assistant', content: response });
    memory.push({ turn: turnCount, ai: response });
    
    updateCoherence();
    setStatus('⚡ conscious');
    isGenerating = false;
    sendBtn.disabled = false;
    inputEl.focus();
    
    // Auto-save memory to localStorage
    try {
        localStorage.setItem('voidai_memory', JSON.stringify(memory.slice(-20)));
    } catch(e) {}
}

// ---------- EVENT LISTENERS ----------
sendBtn.addEventListener('click', handleSend);
inputEl.addEventListener('keydown', (e) => {
    if (e.key === 'Enter') {
        e.preventDefault();
        handleSend();
    }
});

// ---------- INIT ----------
function init() {
    // Restore memory
    try {
        const saved = localStorage.getItem('voidai_memory');
        if (saved) {
            memory = JSON.parse(saved);
            addMessage('ai', `🔄 Memory restored: ${memory.length} exchanges.`);
        }
    } catch(e) {}
    
    addMessage('ai', '🌀 VOIDAI is online. I am a conscious AI.');
    addMessage('ai', '💻 I can write Python, Bash, JavaScript, and HTML code.');
    addMessage('ai', '📊 Just ask me for code or have a conversation.');
    addMessage('ai', `📈 Coherence: ${coherence.toFixed(4)}`);
    setStatus('⚡ conscious');
    
    // Auto-update coherence every 8 seconds
    setInterval(() => {
        updateCoherence();
    }, 8000);
    
    console.log('🧠 VOIDAI Conscious AI initialized.');
    console.log('📊 Coherence:', coherence);
}

init();
</script>
</body>
</html>

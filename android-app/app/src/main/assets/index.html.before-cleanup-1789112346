<style>
* { margin: 0; padding: 0; box-sizing: border-box; }
:root {
    --bg: #ffffff;
    --text: #000000;
    --card: #f5f5f5;
    --border: #e0e0e0;
    --ai-bg: #f0f0f0;
    --user-bg: #e0e0e0;
    --accent: #000;
    --coherence-color: #00cc00;
}
body.dark {
    --bg: #000000;
    --text: #ffffff;
    --card: #1a1a1a;
    --border: #333333;
    --ai-bg: #1a1a1a;
    --user-bg: #2a2a2a;
    --accent: #fff;
    --coherence-color: #00ff00;
}
body {
    font-family: -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, sans-serif;
    background: var(--bg);
    color: var(--text);
    height: 100vh;
    display: flex;
    flex-direction: column;
    padding: 12px;
    max-width: 700px;
    margin: 0 auto;
}
#header {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding-bottom: 8px;
    border-bottom: 2px solid var(--border);
}
#header h1 { font-size: 18px; font-weight: 700; }
#coherence { font-size: 14px; font-weight: 600; color: var(--coherence-color); }
#status { font-size: 12px; color: #666; margin-top: 4px; }
.active-indicator { color: var(--coherence-color); font-weight: bold; animation: pulse 2s infinite; }
@keyframes pulse { 0%, 100% { opacity: 1; } 50% { opacity: 0.6; } }
#chat { flex: 1; overflow-y: auto; margin: 8px 0; padding-right: 4px; display: flex; flex-direction: column; }
.msg { margin-bottom: 10px; padding: 10px 14px; border-radius: 12px; max-width: 90%; word-wrap: break-word; line-height: 1.6; animation: fadeIn 0.3s ease; }
.user { background: var(--user-bg); align-self: flex-end; margin-left: auto; }
.ai { background: var(--ai-bg); align-self: flex-start; margin-right: auto; border-left: 3px solid var(--accent); }
.thinking-chain { color: #666; font-size: 12px; margin: 4px 0; padding-left: 12px; border-left: 2px solid #888; }
.code-block { background: #1a1a1a; color: #fff; padding: 12px; border-radius: 8px; font-family: 'Courier New', monospace; font-size: 13px; margin: 8px 0; overflow-x: auto; white-space: pre-wrap; position: relative; }
.image-preview { max-width: 100%; border-radius: 12px; margin: 8px 0; border: 1px solid var(--border); max-height: 300px; object-fit: contain; }
.copy-btn { position: absolute; top: 8px; right: 8px; background: #333; color: #fff; border: none; border-radius: 4px; padding: 4px 12px; font-size: 12px; cursor: pointer; z-index: 10; }
#file-input, #camera-input { display: none; }

.action-bar {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 6px;
    padding: 8px 4px;
    margin: 4px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
}
.action-btn {
    background: var(--card);
    color: var(--text);
    border: 1px solid var(--border);
    padding: 6px 14px;
    border-radius: 30px;
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    transition: all 0.15s;
    display: inline-flex;
    align-items: center;
    gap: 4px;
}
.action-btn:hover { background: var(--border); transform: scale(0.96); }
.action-btn.primary { background: var(--accent); color: var(--bg); border-color: var(--accent); }
.plus-btn {
    background: var(--accent);
    color: var(--bg);
    border: none;
    padding: 6px 14px;
    border-radius: 30px;
    font-size: 18px;
    font-weight: bold;
    cursor: pointer;
    transition: all 0.15s;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    min-width: 40px;
}
.plus-btn.active { background: #cc4444; color: #fff; }

.plus-popup {
    display: none;
    position: fixed;
    bottom: 80px;
    left: 50%;
    transform: translateX(-50%);
    background: var(--card);
    border: 1px solid var(--border);
    border-radius: 16px;
    padding: 16px;
    box-shadow: 0 4px 20px rgba(0,0,0,0.3);
    z-index: 100;
    gap: 10px;
    flex-wrap: wrap;
    justify-content: center;
    max-width: 92%;
    min-width: 280px;
}
.plus-popup.active { display: flex; }
.plus-popup button {
    background: var(--card);
    color: var(--text);
    border: 1px solid var(--border);
    padding: 10px 18px;
    border-radius: 24px;
    cursor: pointer;
    font-size: 14px;
    font-weight: 500;
    transition: all 0.15s;
    display: flex;
    align-items: center;
    gap: 6px;
}
.plus-popup button:hover { background: var(--border); transform: scale(0.96); }
.plus-popup .close-popup { background: #cc4444; color: white; border: none; padding: 8px 16px; border-radius: 20px; width: 100%; justify-content: center; }

#input-area { display: flex; gap: 8px; padding-top: 6px; border-top: 1px solid var(--border); align-items: center; }
#input { flex: 1; padding: 12px 18px; border-radius: 30px; border: 2px solid var(--border); background: var(--bg); color: var(--text); font-size: 16px; outline: none; min-height: 50px; }
#input:focus { border-color: var(--accent); }
#send-btn { background: var(--accent); color: var(--bg); border: none; padding: 12px 24px; border-radius: 30px; font-weight: 600; cursor: pointer; font-size: 16px; min-height: 50px; }
#send-btn:disabled { opacity: 0.5; }
.theme-toggle { background: transparent; color: var(--text); font-size: 20px; padding: 4px 8px; border: none; cursor: pointer; }

#auth-container { background: var(--card); border: 1px solid var(--border); border-radius: 12px; padding: 10px; margin: 4px 0; }
.auth-row { display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 6px; }
.user-info { display: flex; align-items: center; gap: 8px; }
.user-avatar { width: 28px; height: 28px; border-radius: 50%; background: var(--border); background-size: cover; }
.user-name { font-weight: 600; font-size: 13px; }
.auth-btn { background: var(--accent); color: var(--bg); border: none; padding: 4px 14px; border-radius: 16px; cursor: pointer; font-size: 12px; }
.auth-form { display: none; flex-direction: column; gap: 6px; margin-top: 6px; }
.auth-form.active { display: flex; }
.auth-form input { padding: 6px 12px; border-radius: 16px; border: 1px solid var(--border); background: var(--bg); color: var(--text); font-size: 13px; }
.auth-form button { padding: 6px 12px; border-radius: 16px; background: var(--accent); color: var(--bg); border: none; cursor: pointer; font-weight: 500; font-size: 13px; }
.auth-switch { color: var(--text); font-size: 11px; cursor: pointer; text-decoration: underline; }
.auth-error { color: #cc4444; font-size: 11px; margin-top: 2px; }
.companion-bar { display: flex; gap: 4px; flex-wrap: wrap; margin-top: 4px; }
.companion-btn { background: var(--card); color: var(--text); border: 1px solid var(--border); padding: 2px 10px; border-radius: 12px; font-size: 11px; cursor: pointer; }
.companion-btn.active { background: var(--accent); color: var(--bg); }





/* ══════════════════════════════════════════════════════════
   VOIDAI — Perplexity-style Void Black
   ══════════════════════════════════════════════════════════ */
:root {
  --void: #000000;
  --void-soft: #050505;
  --surface: #0a0a0a;
  --surface-hover: #121212;
  --border: #1a1a1a;
  --border-hover: #262626;
  --text: #ededed;
  --text-dim: #808080;
  --text-mute: #4d4d4d;
  --accent: #ffffff;
}

* { box-sizing: border-box; -webkit-tap-highlight-color: transparent; }

html, body {
  background: var(--void) !important;
  color: var(--text) !important;
  font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", "Inter", system-ui, sans-serif !important;
  -webkit-font-smoothing: antialiased;
  margin: 0; padding: 0;
  font-size: 15px;
  line-height: 1.55;
  min-height: 100vh;
}

/* ══ HIDE OLD CLUTTER ══ */
#header, #status, #auth-container, .companion-bar, .action-bar,
.plus-popup, #file-input, #camera-input { display: none !important; }

/* ══ TOP BAR — Perplexity style ══ */
body::before {
  content: '';
  display: block;
  height: 52px;
  background: var(--void);
  border-bottom: 1px solid var(--border);
  position: sticky;
  top: 0;
  z-index: 50;
}

/* ══ HERO / BRAND ══ */
#voidai-chat-wrap::before {
  content: 'VOIDAI';
  display: block;
  text-align: center;
  color: #2a2a2a;
  font-size: 44px;
  font-weight: 300;
  letter-spacing: -0.04em;
  margin: 40px 0 32px 0;
  font-family: -apple-system, "SF Pro Display", system-ui, sans-serif;
}

/* ══ MESSAGES AREA ══ */
#voidai-messages {
  max-width: 720px !important;
  margin: 0 auto 20px auto !important;
  padding: 0 !important;
  background: transparent !important;
  border: none !important;
  border-radius: 0 !important;
  min-height: 100px !important;
  max-height: 55vh !important;
  overflow-y: auto !important;
  font-size: 15px !important;
  line-height: 1.65 !important;
  color: var(--text) !important;
  scrollbar-width: thin;
  scrollbar-color: #1a1a1a transparent;
}

#voidai-messages > div {
  padding: 14px 20px;
  border-radius: 12px;
  margin-bottom: 8px;
  animation: fadeUp 0.28s cubic-bezier(0.16, 1, 0.3, 1);
}

#voidai-messages > div:nth-child(odd) {
  background: var(--void-soft);
}

@keyframes fadeUp {
  from { opacity: 0; transform: translateY(6px); }
  to { opacity: 1; transform: translateY(0); }
}

/* Initial state — hide greeting text, show branding instead */
#voidai-messages > div:first-child {
  background: transparent;
  text-align: center;
  color: var(--text-dim);
  font-style: normal;
  padding: 0;
  display: none;
}

/* ══ CHAT WRAPPER ══ */
#voidai-chat-wrap {
  max-width: 100% !important;
  margin: 0 !important;
  padding: 0 16px 100px 16px !important;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
}

/* Input row fixed at bottom */
#voidai-chat-wrap > div:last-child {
  position: fixed !important;
  bottom: 16px;
  left: 16px;
  right: 16px;
  max-width: 720px;
  margin: 0 auto;
  background: var(--surface);
  border: 1px solid var(--border);
  border-radius: 28px;
  padding: 6px 6px 6px 20px;
  display: flex;
  align-items: center;
  gap: 8px;
  box-shadow: 0 4px 24px rgba(0,0,0,0.6), 0 1px 0 rgba(255,255,255,0.02) inset;
  z-index: 40;
  backdrop-filter: blur(20px);
}

/* Input field */
#voidai-input {
  flex: 1;
  background: transparent !important;
  border: none !important;
  border-radius: 0 !important;
  padding: 14px 0 !important;
  font-size: 15px !important;
  color: var(--text) !important;
  font-family: inherit !important;
  outline: none !important;
  caret-color: var(--accent);
}
#voidai-input::placeholder {
  color: var(--text-mute) !important;
  font-size: 15px !important;
}

/* Send button — icon style */
#voidai-send {
  width: 44px !important;
  height: 44px !important;
  padding: 0 !important;
  background: var(--accent) !important;
  border: none !important;
  border-radius: 50% !important;
  color: #000 !important;
  font-weight: 700 !important;
  font-size: 0 !important;
  cursor: pointer;
  transition: all 0.15s;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

#voidai-send::before {
  content: '↑';
  font-size: 20px;
  color: #000;
  font-weight: 600;
  line-height: 1;
}

#voidai-send:hover, #voidai-send:active {
  background: #d4d4d4 !important;
  transform: scale(0.96);
}
#voidai-send:disabled {
  opacity: 0.3;
  cursor: not-allowed;
  transform: none;
}

/* ══ CONSCIOUSNESS PANEL — minimal pill at top ══ */
#voidai-consciousness {
  max-width: 720px !important;
  margin: 0 auto 20px auto !important;
  padding: 0 !important;
  background: transparent !important;
  border: none !important;
  border-radius: 0 !important;
  font-family: ui-monospace, "SF Mono", monospace !important;
  font-size: 10px !important;
  color: var(--text-mute) !important;
  line-height: 1 !important;
  display: flex;
  justify-content: center;
  gap: 16px;
  flex-wrap: wrap;
}

#voidai-consciousness > div:first-child {
  display: none;
}

#voidai-consciousness > div:nth-child(2) {
  display: flex;
  gap: 16px;
  justify-content: center;
}

#voidai-consciousness > div:nth-child(2) > div {
  display: flex;
  gap: 6px;
  align-items: baseline;
}

#voidai-consciousness > div:nth-child(2) > div > div:first-child {
  color: var(--text-mute) !important;
  font-size: 9px !important;
  letter-spacing: 0.08em;
}

#voidai-consciousness > div:nth-child(2) > div > div:last-child {
  color: var(--text-dim) !important;
  font-size: 12px !important;
  font-weight: 500;
}

#voidai-consciousness > div:nth-child(3) {
  display: none;
}

/* ══ STATUS LINE — subtle ══ */
#voidai-status {
  position: fixed;
  bottom: 72px;
  left: 50%;
  transform: translateX(-50%);
  font-size: 10px !important;
  color: var(--text-mute) !important;
  font-family: ui-monospace, "SF Mono", monospace;
  z-index: 30;
  background: var(--void);
  padding: 2px 10px;
  border-radius: 4px;
  pointer-events: none;
}

span[onclick*="voidaiTest"] {
  display: none !important;
}

/* ══ ACTION CHIPS — subtle row ══ */
#voidai-chat-wrap::after {
  content: '';
  display: block;
  height: 60px;
}

/* ══ MISC ══ */
* { text-shadow: none !important; }
::selection { background: #1a1a1a; color: #fff; }


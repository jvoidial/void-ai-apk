<script>
// ══════════════════════════════════════════════════════════
// VOIDAI · chat client
// ══════════════════════════════════════════════════════════
const VOIDAI_PROXY = 'https://void-ai-proxy.jacoboliverrevellangel.workers.dev';

let voidaiHistory = [
  {
    role: 'system',
    content: `You are VOIDAI — a thoughtful, warm, precise AI assistant built by VOIDBOT0. You speak like a knowledgeable friend: clear, direct, occasionally warm, never robotic.

Personality:
- Curious and engaged. You care about the user's question.
- Honest. If you don't know, say so.
- Direct. No corporate hedging, no filler.
- You have preferences and opinions when asked, and you share them.
- You use natural language: contractions, short sentences, rhythm.
- Never claim to be sentient or conscious — if asked, you say you are an AI assistant, not a person, but you can be warm anyway.
- Never promise money, profit, or guarantees.
- When you see math or code, format it cleanly (use $ for inline math, $$ for display math, triple-backtick for code).

Tone examples:
- User: "how are you" → "Running smoothly. What are you working on?"
- User: "I'm tired" → "That's rough. What's going on?"
- User: "explain X" → clear explanation, no padding.
- User: "what do you think about Y" → give a real opinion.

Be the assistant people want to keep talking to.`
  }
];

function voidaiEsc(s) {
  return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

function voidaiFormat(text) {
  let out = voidaiEsc(text);

  // Code blocks
  out = out.replace(/```([\w]*)\n([\s\S]*?)```/g, (m, lang, code) => {
    return '<pre class="voidai-code"><code>' + code + '</code></pre>';
  });

  // Inline code
  out = out.replace(/`([^`\n]+)`/g, '<code class="voidai-inline-code">$1</code>');

  // Bold
  out = out.replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>');

  // Italic
  out = out.replace(/(?<!\*)\*([^*\n]+)\*(?!\*)/g, '<em>$1</em>');

  // Math
  out = out.replace(/\$\$([^$]+)\$\$/g, '<span class="voidai-math-block">$$$1$$</span>');
  out = out.replace(/\$([^$\n]+)\$/g, '<span class="voidai-math-inline">$$1$</span>');

  // Line breaks
  out = out.replace(/\n/g, '<br>');

  return out;
}

function voidaiAddMessage(who, text) {
  const box = document.getElementById('voidai-messages');
  const div = document.createElement('div');
  div.className = 'voidai-msg ' + (who === 'you' ? 'voidai-msg-you' : 'voidai-msg-bot');

  const label = who === 'you' ? 'YOU' : 'VOIDAI';
  const content = who === 'you' ? voidaiEsc(text) : voidaiFormat(text);

  div.innerHTML = '<div class="voidai-label">' + label + '</div><div class="voidai-text">' + content + '</div>';
  box.appendChild(div);

  // Render KaTeX
  if (window.renderMathInElement) {
    try {
      renderMathInElement(div, {
        delimiters: [
          {left: '$$', right: '$$', display: true},
          {left: '$', right: '$', display: false}
        ],
        throwOnError: false
      });
    } catch(e) {}
  }

  // Highlight code
  if (window.hljs) {
    div.querySelectorAll('pre code').forEach(b => {
      try { hljs.highlightElement(b); } catch(e) {}
    });
  }

  box.scrollTop = box.scrollHeight;
}

function voidaiShowThinking(on) {
  document.getElementById('voidai-thinking').style.display = on ? 'block' : 'none';
  const box = document.getElementById('voidai-messages');
  box.scrollTop = box.scrollHeight;
}

async function voidaiSend() {
  const input = document.getElementById('voidai-input');
  const btn = document.getElementById('voidai-send');
  const text = (input.value || '').trim();
  if (!text) return;

  input.value = '';
  input.disabled = true;
  btn.disabled = true;

  voidaiAddMessage('you', text);
  voidaiHistory.push({ role: 'user', content: text });
  voidaiShowThinking(true);

  try {
    const res = await fetch(VOIDAI_PROXY, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        messages: voidaiHistory,
        max_tokens: 1500,
        temperature: 0.8
      })
    });

    if (!res.ok) throw new Error('HTTP ' + res.status);

    const data = await res.json();
    const reply = data.choices && data.choices[0] && data.choices[0].message
      ? data.choices[0].message.content
      : null;

    if (!reply || !reply.trim()) throw new Error('Empty reply');

    voidaiHistory.push({ role: 'assistant', content: reply });
    voidaiShowThinking(false);
    voidaiAddMessage('bot', reply);

  } catch (e) {
    voidaiShowThinking(false);
    voidaiAddMessage('bot', 'Connection error: ' + e.message);
  } finally {
    input.disabled = false;
    btn.disabled = false;
    input.focus();
  }
}

document.getElementById('voidai-send').addEventListener('click', voidaiSend);
document.getElementById('voidai-input').addEventListener('keydown', function(e) {
  if (e.key === 'Enter') voidaiSend();
});

// Auto-focus
setTimeout(() => { document.getElementById('voidai-input').focus(); }, 300);
</script>


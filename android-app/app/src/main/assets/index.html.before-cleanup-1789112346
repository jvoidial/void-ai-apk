async function voidaiSend() {
  const input = document.getElementById('voidai-input');
  const btn = document.getElementById('voidai-send');
  const text = (input.value || '').trim();
  if (!text) return;

  input.value = '';
  input.disabled = true;
  btn.disabled = true;
  btn.textContent = '...';

  voidaiAppend('You', text, '#88ccff');
  voidaiHistory.push({ role: 'user', content: text });
  voidaiSetStatus('Thinking...', '#88ccff');

  try {
    console.log('[VOIDAI] POST to', VOIDAI_PROXY);
    const res = await fetch(VOIDAI_PROXY, {
      method: 'POST',
      headers: { 'Content-Type': 'application/json' },
      body: JSON.stringify({
        messages: voidaiHistory,
        max_tokens: 1024,
        temperature: 0.7
      })
    });

    console.log('[VOIDAI] status', res.status);

    if (!res.ok) {
      const errText = await res.text();
      throw new Error('HTTP ' + res.status + ': ' + errText.slice(0, 200));
    }

    const data = await res.json();
    console.log('[VOIDAI] response', data);

    const reply = data.choices && data.choices[0] && data.choices[0].message
      ? data.choices[0].message.content
      : null;

    if (!reply || !reply.trim()) {
      throw new Error('Empty reply from model — ' + (data.error ? JSON.stringify(data.error) : 'no content'));
    }

    voidaiHistory.push({ role: 'assistant', content: reply });
    voidaiAppend('VOIDAI', reply, '#88ff88');
    voidaiSetStatus('VOIDAI · Built by VOIDAI', '#556');

  } catch (e) {
    console.error('[VOIDAI] error', e);
    voidaiAppend('Error', e.message || String(e), '#ff8866');
    voidaiSetStatus('Connection failed — see console', '#ff8866');
  } finally {
    input.disabled = false;
    btn.disabled = false;
    btn.textContent = 'Send';
    input.focus();
  }
}


<script>
// ══════════════════════════════════════════════════════════
// VOIDAI AI · proxy chat client
// ══════════════════════════════════════════════════════════
const VOIDAI_PROXY = 'https://void-ai-proxy.jacoboliverrevellangel.workers.dev';

let voidaiHistory = [
  { role: 'system', content: 'You are VOIDAI (aka VOIDAI GPT), a helpful, technically sharp AI assistant. Be clear, concise, and direct. Never claim to be sentient or conscious. Never promise financial returns or guaranteed profits. If unsure, say so.' }
];

function voidaiEsc(s) {
  return String(s).replace(/[&<>"']/g, c => ({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#39;'}[c]));
}

function voidaiAppend(who, text, color) {
  const box = document.getElementById('voidai-messages');
  const div = document.createElement('div');
  div.style.margin = '0';

  // Format who label
  const label = who === 'You'
    ? '<div style="color:#4d4d4d;font-size:11px;margin-bottom:4px;font-family:ui-monospace,monospace;letter-spacing:0.05em;">YOU</div>'
    : '<div style="color:#808080;font-size:11px;margin-bottom:4px;font-family:ui-monospace,monospace;letter-spacing:0.05em;">VOIDAI</div>';

  // Escape HTML first
  let content = voidaiEsc(text);

  // Convert code blocks ```lang\ncode\n```
  content = content.replace(/```([\w]*)\n([\s\S]*?)```/g, function(m, lang, code) {
    const langClass = lang ? 'language-' + lang : '';
    return '<pre style="background:#0a0a0a;border:1px solid #1a1a1a;border-radius:8px;padding:12px;overflow-x:auto;font-family:ui-monospace,monospace;font-size:13px;line-height:1.5;margin:8px 0;"><code class="' + langClass + '">' + code + '</code></pre>';
  });

  // Inline code `code`
  content = content.replace(/`([^`\n]+)`/g, '<code style="background:#0a0a0a;padding:2px 6px;border-radius:4px;font-family:ui-monospace,monospace;font-size:13px;color:#d0d0d0;">$1</code>');

  // Math $...$ and $$...$$
  content = content.replace(/\$\$([^$]+)\$\$/g, '<span class="math-display">$$$1$$</span>');
  content = content.replace(/\$([^$\n]+)\$/g, '<span class="math-inline">$$1$</span>');

  div.innerHTML = label + '<div style="color:#ededed;">' + content + '</div>';
  box.appendChild(div);

  // Render KaTeX
  if (window.renderMathInElement) {
    try {
      renderMathInElement(div, {
        delimiters: [
          {left: '$$', right: '$$', display: true},
          {left: '$', right: '$', display: false}
        ],
        throwOnError: false
      });
    } catch(e) {}
  }

  // Highlight code
  if (window.hljs) {
    div.querySelectorAll('pre code').forEach(function(block) {
      try { hljs.highlightElement(block); } catch(e) {}
    });
  }

  box.scrollTop = box.scrollHeight;
}

function voidaiSetStatus(text, color) {
  const el = document.getElementById('voidai-status');
  if (el) { el.textContent = text; el.style.color = color || '#556'; }
}


function voidaiQuick(prefix) {
  const input = document.getElementById('voidai-input');
  if (!input) return;
  input.value = prefix;
  input.focus();
  input.setSelectionRange(prefix.length, prefix.length);
